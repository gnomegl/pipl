.TH PIPL-PEOPLE 1  "pipl-people 0.0.0" 
.SH NAME
pipl\-people \- Search for people by name, location, email, or phone
.SH SYNOPSIS
\fBpipl people\fR [OPTIONS] [QUERY]
.SH OPTIONS
.TP
\fB\-f\fR, \fB\-\-first\fR=\fIFIRST\fR
.br
"First name"
.TP
\fB\-l\fR, \fB\-\-last\fR=\fILAST\fR
.br
"Last name"
.TP
\fB\-m\fR, \fB\-\-middle\fR=\fIMIDDLE\fR
.br
"Middle name"
.TP
\fB\-n\fR, \fB\-\-name\fR=\fINAME\fR
.br
"Full name (unparsed)"
.TP
\fB\-\-house\fR=\fIHOUSE\fR
.br
"House number"
.TP
\fB\-\-street\fR=\fISTREET\fR
.br
"Street name"
.TP
\fB\-c\fR, \fB\-\-city\fR=\fICITY\fR
.br
"City name"
.TP
\fB\-s\fR, \fB\-\-state\fR=\fISTATE\fR
.br
"State or province"
.TP
\fB\-z\fR, \fB\-\-zip\fR=\fIZIP\fR
.br
"ZIP/postal code"
.TP
\fB\-\-country\fR=\fICOUNTRY\fR
.br
"Country (2\-letter ISO code)"
.TP
\fB\-a\fR, \fB\-\-address\fR=\fIADDRESS\fR
.br
"Full address (unparsed)"
.TP
\fB\-\-age\fR=\fIAGE\fR
.br
"Age or age range (e.g., 25 or 25\-30)"
.TP
\fB\-\-no\-followup\fR
.br
"Disable automatic search pointer follow\-up"
.TP
\fB\-h\fR, \fB\-\-help\fR
.br
Print help
.TP
[\fIQUERY\fR]
.br
"Quick search: 'John Doe' or 'john.doe@email.com' or phone"
