#!/usr/bin/env bash

# @describe PIPL Search API client for people intelligence and data enrichment
# @arg command "Command to run (people, email, phone, pointer, person-json)" [string]
# @arg value "Email address for email command, phone number for phone command, search pointer for pointer command, person JSON for person-json command" [string]

# Global options (available for all commands)
# @option -k --key "PIPL API key (can also use PIPL_API_KEY env var)" [string]
# @flag   -j --json "Deprecated - JSON is now the default output"
# @flag   -q --quiet "Suppress colored output"


# Search configuration options (available for all search commands)
# @option --minimum-probability "Minimum acceptable probability for inferred data (0-1)" [float] @default "0.9"
# @option --minimum-match "Minimum required match score for possible persons (0-1)" [float] @default "0"
# @option --show-sources "Sources to show (true, false, all, matching)" [string] @default "false"
# @flag   --live-feeds "Whether to use live data sources"
# @option --match-requirements "Fields that must be present in response" [string]
# @option --source-category-requirements "Source categories that must be present" [string]
# @flag   --no-top-match "Return all matches instead of just the top match (default: top match only)"
# @flag   --hide-sponsored "Omit sponsored results"

# People search parameters (only available for 'people' command)
# @option -f --first-name "First name or given name" [string]
# @option -m --middle-name "Middle name" [string]
# @option -l --last-name "Last name or family name" [string]
# @option --raw-name "Full name (use if not parsed into components)" [string]
# @option --house "House number" [string]
# @option --street "Street portion of address" [string]
# @option -c --city "City" [string]
# @option -s --state "State or province" [string]
# @option -z --zipcode "Zipcode or postal code" [string]
# @option --country "Country ISO Alpha 2-Code" [string]
# @option --raw-address "Full address (use if not parsed into components)" [string]
# @option -a --age "Exact (YY) or approximate (YY-YY) age" [string]
# @option -u --username "Username (minimum 3 characters)" [string]
# @option --user-id "User ID with service name (e.g. 11231@facebook)" [string]
# @option --url "Social media profile URL" [string]
# @meta require-tools curl,jq

eval "$(argc --argc-eval "$0" "$@")"

# Setup colors
setup_colors() {
  if [ "${argc_quiet:-0}" = 1 ] || [ -z "$TERM" ] || [ "$TERM" = "dumb" ]; then
    bold="" reset="" blue="" green="" yellow="" cyan="" magenta="" red="" dim=""
  else
    bold=$(tput bold) reset=$(tput sgr0) blue=$(tput setaf 4) green=$(tput setaf 2)
    yellow=$(tput setaf 3) cyan=$(tput setaf 6) magenta=$(tput setaf 5) red=$(tput setaf 1)
    dim=$(tput dim)
  fi
}
setup_colors

# Get API key from multiple sources
get_api_key() {
  if [ -n "$argc_key" ]; then
    echo "$argc_key"
  elif [ -n "$PIPL_API_KEY" ]; then
    echo "$PIPL_API_KEY"
  elif [ -f "$HOME/.config/pipl/api_key" ]; then
    cat "$HOME/.config/pipl/api_key"
  else
    echo "${red}Error:${reset} No PIPL API key found." >&2
    echo "Either:" >&2
    echo "  1. Pass it with --key" >&2
    echo "  2. Set PIPL_API_KEY environment variable" >&2
    echo "  3. Save it to ~/.config/pipl/api_key" >&2
    exit 1
  fi
}
API_KEY=$(get_api_key)
API_BASE="https://api.pipl.com"

# Helper functions
print_kv() {
  printf "${bold}%s:${reset} %s\n" "$1" "$2"
}

print_section() {
  printf "\n${bold}%s:${reset}\n" "$1"
}

format_date_range() {
  local start="$1"
  local end="$2"
  if [ "$start" = "$end" ]; then
    echo "$start"
  else
    echo "${start} - ${end}"
  fi
}

make_request() {
  local method="$1"
  local params="$2"
  local data="$3"

  local url="${API_BASE}/search?key=${API_KEY}${params}"
  local response

  if [ "$method" = "GET" ]; then
    response=$(curl -s "$url")
  else
    response=$(curl -s -X POST -H "Content-Type: application/x-www-form-urlencoded" -d "$data" "$url")
  fi

  # Check for errors
  local http_status=$(echo "$response" | jq -r '.["@http_status_code"] // 200')
  if [ "$http_status" != "200" ]; then
    local error_msg=$(echo "$response" | jq -r '.error // "Unknown error"')
    printf "${red}Error (HTTP %s):${reset} %s\n" "$http_status" "$error_msg" >&2

    local warnings=$(echo "$response" | jq -r '.warnings[]? // empty' 2>/dev/null)
    if [ -n "$warnings" ]; then
      printf "${yellow}Warnings:${reset}\n" >&2
      echo "$warnings" | while read -r warning; do
        printf "  ${yellow}•${reset} %s\n" "$warning" >&2
      done
    fi
    exit 1
  fi

  echo "$response"
}

build_search_params() {
  local params=""

  # Search configuration
  [ -n "$argc_minimum_probability" ] && params="${params}&minimum_probability=${argc_minimum_probability}"
  [ -n "$argc_minimum_match" ] && params="${params}&minimum_match=${argc_minimum_match}"
  [ -n "$argc_show_sources" ] && params="${params}&show_sources=${argc_show_sources}"
  if [ "$argc_live_feeds" = 1 ]; then
    params="${params}&live_feeds=true"
  else
    params="${params}&live_feeds=false"
  fi
  [ -n "$argc_match_requirements" ] && params="${params}&match_requirements=${argc_match_requirements}"
  [ -n "$argc_source_category_requirements" ] && params="${params}&source_category_requirements=${argc_source_category_requirements}"
  # Default to top_match=true unless --no-top-match is specified
  if [ "$argc_no_top_match" != 1 ]; then
    params="${params}&top_match=true"
  fi
  [ "$argc_hide_sponsored" = 1 ] && params="${params}&hide_sponsored=true"

  # Name parameters
  [ -n "$argc_first_name" ] && params="${params}&first_name=$(printf '%s' "$argc_first_name" | sed 's/ /%20/g')"
  [ -n "$argc_middle_name" ] && params="${params}&middle_name=$(printf '%s' "$argc_middle_name" | sed 's/ /%20/g')"
  [ -n "$argc_last_name" ] && params="${params}&last_name=$(printf '%s' "$argc_last_name" | sed 's/ /%20/g')"
  [ -n "$argc_raw_name" ] && params="${params}&raw_name=$(printf '%s' "$argc_raw_name" | sed 's/ /%20/g')"

  # Address parameters
  [ -n "$argc_house" ] && params="${params}&house=$(printf '%s' "$argc_house" | sed 's/ /%20/g')"
  [ -n "$argc_street" ] && params="${params}&street=$(printf '%s' "$argc_street" | sed 's/ /%20/g')"
  [ -n "$argc_city" ] && params="${params}&city=$(printf '%s' "$argc_city" | sed 's/ /%20/g')"
  [ -n "$argc_state" ] && params="${params}&state=$(printf '%s' "$argc_state" | sed 's/ /%20/g')"
  [ -n "$argc_zipcode" ] && params="${params}&zipcode=${argc_zipcode}"
  [ -n "$argc_country" ] && params="${params}&country=${argc_country}"
  [ -n "$argc_raw_address" ] && params="${params}&raw_address=$(printf '%s' "$argc_raw_address" | sed 's/ /%20/g')"

  # Other parameters
  [ -n "$argc_age" ] && params="${params}&age=${argc_age}"
  [ -n "$argc_username" ] && params="${params}&username=${argc_username}"
  [ -n "$argc_user_id" ] && params="${params}&user_id=${argc_user_id}"
  [ -n "$argc_url" ] && params="${params}&url=$(printf '%s' "$argc_url" | sed 's/&/%26/g')"
  [ -n "$argc_email" ] && params="${params}&email=$(printf '%s' "$argc_email" | sed 's/@/%40/g; s/\./%2E/g')"
  [ -n "$argc_phone" ] && params="${params}&phone=$(printf '%s' "$argc_phone" | sed 's/ /%20/g; s/+/%2B/g')"

  echo "$params"
}

