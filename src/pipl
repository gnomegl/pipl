}

# @cmd Search by user ID
# @arg user_id! "User ID with service (e.g., 123456@facebook)"
user-id() {
  setup_colors
  API_KEY=$(get_api_key)

  local params
  params=$(build_search_params)
  # shellcheck disable=SC2154
  params+="&user_id=$(url_encode "${argc_user_id}")"

  local response
  response=$(make_request "GET" "$params")
  format_response "$response"
}

# @cmd Follow up on a search pointer
# @arg search_pointer! "Search pointer from previous results"
pointer() {
  setup_colors
  API_KEY=$(get_api_key)

  local params
  params=$(build_search_params)
  # shellcheck disable=SC2154
  local data="sp=${argc_search_pointer}"

  local response
  response=$(make_request "POST" "$params" "$data")
  format_response "$response"
}

# @cmd Search for people by name, location, email, or phone
# @alias search
# @option -f --first "First name"
# @option -l --last "Last name"
# @option -m --middle "Middle name"
# @option -n --name "Full name (unparsed)"
# @option --house "House number"
# @option --street "Street name"
# @option -c --city "City name"
# @option -s --state "State or province"
# @option -z --zip "ZIP/postal code"
# @option --country "Country (2-letter ISO code)"
# @option -a --address "Full address (unparsed)"
# @option --age "Age or age range (e.g., 25 or 25-30)"
# @flag --no-followup "Disable automatic search pointer follow-up"
# @arg query "Quick search: 'John Doe' or 'john.doe@email.com' or phone"
people() {
  setup_colors
  API_KEY=$(get_api_key)

  local params
  params=$(build_search_params)

  # If a quick query arg is provided, determine what it is
  # shellcheck disable=SC2154
  if [[ -n "${argc_query}" ]]; then
    # Check if it's an email
    if [[ "${argc_query}" =~ ^[^@]+@[^@]+\.[^@]+$ ]]; then
      params+="&email=$(url_encode "${argc_query}")"
    # Check if it's a phone number (contains mostly digits)
    elif [[ "${argc_query}" =~ ^[0-9+\(\)\ \-\.]+$ ]] && [[ "${#argc_query}" -ge 7 ]]; then
      local cleaned_phone
      cleaned_phone=$(echo "${argc_query}" | tr -d '().-' | tr -s ' ')
      params+="&phone=$(url_encode "$cleaned_phone")"
    # Otherwise treat as a name
    else
      params+="&raw_name=$(url_encode "${argc_query}")"
    fi
  fi

  # Add explicit parameters if provided
  [[ -n "${argc_first}" ]] && params+="&first_name=$(url_encode "${argc_first}")"
  [[ -n "${argc_middle}" ]] && params+="&middle_name=$(url_encode "${argc_middle}")"
  [[ -n "${argc_last}" ]] && params+="&last_name=$(url_encode "${argc_last}")"
  [[ -n "${argc_name}" ]] && params+="&raw_name=$(url_encode "${argc_name}")"
  [[ -n "${argc_house}" ]] && params+="&house=$(url_encode "${argc_house}")"
  [[ -n "${argc_street}" ]] && params+="&street=$(url_encode "${argc_street}")"
  [[ -n "${argc_city}" ]] && params+="&city=$(url_encode "${argc_city}")"
  [[ -n "${argc_state}" ]] && params+="&state=$(url_encode "${argc_state}")"
  [[ -n "${argc_zip}" ]] && params+="&zipcode=${argc_zip}"
  [[ -n "${argc_country}" ]] && params+="&country=${argc_country}"
  [[ -n "${argc_address}" ]] && params+="&raw_address=$(url_encode "${argc_address}")"
  [[ -n "${argc_age}" ]] && params+="&age=${argc_age}"

  # Check if we have at least one search parameter
  if [[ -z "${argc_query}${argc_first}${argc_last}${argc_name}${argc_city}${argc_state}${argc_country}${argc_address}${argc_age}${argc_house}${argc_street}" ]]; then
    echo "${red}Error:${reset} At least one search parameter is required" >&2
    echo "Try: pipl people 'John Doe' or pipl people --first John --last Doe" >&2
    exit 1
  fi

  local response
  response=$(make_request "GET" "$params")
  
  # Check if we got an exact match with a search pointer and auto-followup is enabled
  if [[ "${argc_no_followup:-0}" != "1" ]]; then
    local person_pointer
    person_pointer=$(echo "$response" | jq -r '.person["@search_pointer"] // empty')
    
    if [[ -n "$person_pointer" ]]; then
      # Display initial results
      format_response "$response"
      
      # Inform user about follow-up
      printf "\n%s━━━ Fetching additional details via search pointer ━━━%s\n\n" "$cyan" "$reset"
      
      # Make follow-up request with search pointer
      local followup_params
      followup_params=$(build_search_params)
      local followup_data="sp=${person_pointer}"
      local followup_response
      followup_response=$(make_request "POST" "$followup_params" "$followup_data")
      
      # Display enhanced results
      printf "%s%sENHANCED MATCH DETAILS%s\n" "$bold" "$green" "$reset"
    printf "%s%s%s\n" "$bold" "$(printf '━%.0s' {1..60})" "$reset"
      format_response "$followup_response"
    else
      # No exact match or no search pointer, just display regular results
      format_response "$response"
    fi
  else
    # Auto-followup disabled, just display regular results
    format_response "$response"
  fi
}

# @cmd Search using person JSON object
# @arg person_json! "JSON person object"
person() {
  setup_colors
  API_KEY=$(get_api_key)
  # shellcheck disable=SC2154
  if ! echo "${argc_person_json}" | jq . >/dev/null 2>&1; then
    echo "${red}Error:${reset} Invalid JSON format" >&2
    exit 1
  fi

  local params
  params=$(build_search_params)
  local encoded_person
  encoded_person=$(url_encode "${argc_person_json}")
  local data="person=$encoded_person"

  local response
  response=$(make_request "POST" "$params" "$data")
  format_response "$response"
}

eval "$(argc --argc-eval "$0" "$@")"
