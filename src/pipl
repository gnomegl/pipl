#!/usr/bin/env bash

# @describe PIPL Search API client for people intelligence and data enrichment
# @meta require-tools curl,jq

# Global options
# @option -k --key "PIPL API key (can also use PIPL_API_KEY env var)"
# @flag -j --json "Output raw JSON (default is formatted)"
# @flag -q --quiet "Suppress colored output"

# Search configuration options (inherited by search commands)
# @option --minimum-probability "Minimum acceptable probability for inferred data (0-1)" @default "0.9"
# @option --minimum-match "Minimum required match score for possible persons (0-1)" @default "0"
# @option --show-sources "Sources to show" [true|false|all|matching] @default "true"
# @flag --no-live-feeds "Disable live data sources"
# @option --match-requirements "Fields that must be present in response"
# @option --source-category-requirements "Source categories that must be present"
# @flag --top-match "Return only the top match (default behavior)"
# @flag --hide-sponsored "Omit sponsored results"

setup_colors() {
  if [[ "${argc_quiet:-0}" == "1" || -z "$TERM" || "$TERM" == "dumb" ]]; then
    bold="" reset="" blue="" green="" yellow="" cyan="" magenta="" red="" dim=""
  else
    bold=$(tput bold) reset=$(tput sgr0) blue=$(tput setaf 4) green=$(tput setaf 2)
    yellow=$(tput setaf 3) cyan=$(tput setaf 6) magenta=$(tput setaf 5) red=$(tput setaf 1)
    dim=$(tput dim)
  fi
}

get_api_key() {
  if [[ -n "$argc_key" ]]; then
    echo "$argc_key"
  elif [[ -n "$PIPL_API_KEY" ]]; then
    echo "$PIPL_API_KEY"
  elif [[ -f "$HOME/.config/pipl/api_key" ]]; then
    cat "$HOME/.config/pipl/api_key"
  else
    printf "%sError:%s No PIPL API key found.\n" "$red" "$reset" >&2
    echo "Set with --key, PIPL_API_KEY env var, or ~/.config/pipl/api_key file" >&2
    exit 1
  fi
}

make_request() {
  local method="$1"
  local params="$2"
  local data="$3"

  local url="https://api.pipl.com/search?key=${API_KEY}${params}"
  local response

  if [[ "$method" == "GET" ]]; then
    response=$(curl -s "$url")
  else
    response=$(curl -s -X POST -H "Content-Type: application/x-www-form-urlencoded" -d "$data" "$url")
  fi

  local http_status
  http_status=$(echo "$response" | jq -r '.["@http_status_code"] // 200')
  if [[ "$http_status" != "200" ]]; then
    local error_msg
    error_msg=$(echo "$response" | jq -r '.error // "Unknown error"')
    printf "%sError (HTTP %s):%s %s\n" "$red" "$http_status" "$error_msg" "$reset" >&2

    local warnings
    warnings=$(echo "$response" | jq -r '.warnings[]?' 2>/dev/null)
    if [[ -n "$warnings" ]]; then
      printf "%sWarnings:%s\n" "$yellow" "$reset" >&2
      while read -r warning; do
        printf "  %s•%s %s\n" "$yellow" "$reset" "$warning" >&2
      done <<<"$warnings"
    fi
    exit 1
  fi

  echo "$response"
}

build_search_params() {
  local params=""

  [[ -n "$argc_minimum_probability" ]] && params+="&minimum_probability=${argc_minimum_probability}"
  [[ -n "$argc_minimum_match" ]] && params+="&minimum_match=${argc_minimum_match}"
  [[ -n "$argc_show_sources" ]] && params+="&show_sources=${argc_show_sources}"
  [[ "${argc_no_live_feeds:-0}" == "1" ]] && params+="&live_feeds=false"
  [[ -n "$argc_match_requirements" ]] && params+="&match_requirements=${argc_match_requirements}"
  [[ -n "$argc_source_category_requirements" ]] && params+="&source_category_requirements=${argc_source_category_requirements}"
  [[ "${argc_top_match:-0}" == "1" ]] && params+="&top_match=true"
  [[ "${argc_hide_sponsored:-0}" == "1" ]] && params+="&hide_sponsored=true"

  echo "$params"
}

url_encode() {
  local string="$1"
  printf '%s' "$string" | sed 's/ /%20/g; s/@/%40/g; s/\./%2E/g; s/+/%2B/g; s/&/%26/g'
}

format_person() {
  local person="$1"
  local match_score=""

  match_score=$(echo "$person" | jq -r '.["@match"] // empty')
  [[ -n "$match_score" ]] && printf "${bold}Match Score:${reset} ${yellow}%.2f${reset}\n" "$match_score"

  local names
  names=$(echo "$person" | jq -r '.names[]?' 2>/dev/null)
  if [[ -n "$names" ]]; then
    printf "\n%sNames:%s\n" "$bold" "$reset"
    echo "$person" | jq -r '.names[] | "\(.first // "")|\(.middle // "")|\(.last // "")|\(.display // "")"' |
      while IFS="|" read -r first middle last display; do
        printf "  %s%%s" "$green" "$first"
        [[ -n "$middle" ]] && printf " %s" "$middle"
        [[ -n "$last" ]] && printf " %s" "$last"
        [[ -n "$display" && "$display" != "$first $middle $last" ]] && printf " ${dim}(%s)${reset}" "$display"
        printf "%s\n" "$reset"
      done
  fi

  local gender
  gender=$(echo "$person" | jq -r '.gender.content // empty')
  local dob
  dob=$(echo "$person" | jq -r '.dob.display // empty')

  if [[ -n "$gender" || -n "$dob" ]]; then
    printf "\n%sPersonal Info:%s\n" "$bold" "$reset"
    [[ -n "$gender" ]] && printf "  %sGender:%s %s%s%s\n" "$cyan" "$reset" "$magenta" "$gender" "$reset"
    [[ -n "$dob" ]] && printf "  %sDate of Birth:%s %s%s%s\n" "$cyan" "$reset" "$yellow" "$dob" "$reset"
  fi

  local phones
  phones=$(echo "$person" | jq -r '.phones[]?' 2>/dev/null)
  if [[ -n "$phones" ]]; then
    printf "\n%sPhone Numbers:%s\n" "$bold" "$reset"
    echo "$person" | jq -r '.phones[] | "\(.["@type"] // "phone")|\(.display_international // .display // "")"' |
      while IFS="|" read -r type display; do
        printf "  %s%s:%s %s%s%s\n" "$cyan" "${type^}" "$reset" "$blue" "$display" "$reset"
      done
  fi

  local addresses
  addresses=$(echo "$person" | jq -r '.addresses[]?' 2>/dev/null)
  if [[ -n "$addresses" ]]; then
    printf "\n%sAddresses:%s\n" "$bold" "$reset"
    echo "$person" | jq -r '.addresses[].display // empty' |
      while read -r address; do
        [[ -n "$address" ]] && printf "  %s%s%s\n" "$magenta" "$address" "$reset"
      done
  fi

  local jobs
  jobs=$(echo "$person" | jq -r '.jobs[]?' 2>/dev/null)
  if [[ -n "$jobs" ]]; then
    printf "\n%sEmployment:%s\n" "$bold" "$reset"
    echo "$person" | jq -r '.jobs[] | "\(.title // "")|\(.organization // "")"' |
      while IFS="|" read -r title org; do
        printf "  %s%s%s" "$yellow" "$title" "$reset"
        [[ -n "$org" ]] && printf " at %s%s%s" "$blue" "$org" "$reset"
        printf "\n"
      done
  fi

  local educations
  educations=$(echo "$person" | jq -r '.educations[]?' 2>/dev/null)
  if [[ -n "$educations" ]]; then
    printf "\n%sEducation:%s\n" "$bold" "$reset"
    echo "$person" | jq -r '.educations[] | "\(.degree // "")|\(.school // "")"' |
      while IFS="|" read -r degree school; do
        printf "  %s%s%s" "$yellow" "$degree" "$reset"
        [[ -n "$school" ]] && printf " from %s%s%s" "$blue" "$school" "$reset"
        printf "\n"
      done
  fi

  local usernames
  usernames=$(echo "$person" | jq -r '.usernames[]?' 2>/dev/null)
  local user_ids
  user_ids=$(echo "$person" | jq -r '.user_ids[]?' 2>/dev/null)

  if [[ -n "$usernames" || -n "$user_ids" ]]; then
    printf "\n%sSocial Media:%s\n" "$bold" "$reset"
    echo "$person" | jq -r '.usernames[].content // empty' |
      while read -r username; do
        printf "  %s@%s%s\n" "$cyan" "$username" "$reset"
      done
    echo "$person" | jq -r '.user_ids[].content // empty' |
      while read -r user_id; do
        printf "  %s%s%s\n" "$blue" "$user_id" "$reset"
      done
  fi

  local search_pointer
  search_pointer=$(echo "$person" | jq -r '.["@search_pointer"] // empty')
  if [[ -n "$search_pointer" ]]; then
    printf "\n%sFollow-up search: pipl pointer '%s'%s\n" "$dim" "${search_pointer:0:50}..." "$reset"
  fi
}

format_response() {
  local response="$1"

  if [[ "${argc_json:-0}" == "1" ]]; then
    echo "$response" | jq
    return
  fi

  local persons_count
  persons_count=$(echo "$response" | jq -r '.["@persons_count"] // 0')
  local search_id
  search_id=$(echo "$response" | jq -r '.["@search_id"] // "N/A"')

  printf "%sSearch ID: %s | Persons found: %s%s\n" "$dim" "$search_id" "$persons_count" "$reset"

  local person
  person=$(echo "$response" | jq -r '.person // empty')
  if [[ -n "$person" && "$person" != "null" ]]; then
    printf "\n%s%sEXACT MATCH%s\n" "$bold" "$green" "$reset"
    printf "${bold}%s${reset}\n" "$(printf '━%.0s' {1..60})"
    format_person "$person"
  fi

  local possible_count
  possible_count=$(echo "$response" | jq -r '.possible_persons | length // 0')
  if [[ "$possible_count" -gt 0 ]]; then
    printf "\n%s%sPOSSIBLE MATCHES (%s)%s\n" "$bold" "$yellow" "$possible_count" "$reset"
    printf "%s%s%s\n" "$bold" "$(printf '━%.0s' {1..60})" "$reset"

    local count=1
    echo "$response" | jq -c '.possible_persons[]?' | while read -r possible_person; do
      printf "\n%sMatch #%s:%s\n" "$bold" "$count" "$reset"
      format_person "$possible_person"
      count=$((count + 1))
    done
  fi

  local warnings
  warnings=$(echo "$response" | jq -r '.warnings[]?' 2>/dev/null)
  if [[ -n "$warnings" ]]; then
    printf "\n%sWarnings:%s\n" "$yellow" "$reset"
    while read -r warning; do
      printf "  %s•%s %s\n" "$yellow" "$reset" "$warning"
    done <<<"$warnings"
  fi
}

# @cmd Search by email address
# @arg email! "Email address to search"
email() {
  setup_colors
  API_KEY=$(get_api_key)

  local params
  params=$(build_search_params)
  # shellcheck disable=SC2154
  params+="&email=$(url_encode "${argc_email}")"

  local response
  response=$(make_request "GET" "$params")
  format_response "$response"
}

# @cmd Search by phone number
# @arg phone! "Phone number (international format preferred)"
phone() {
  setup_colors
  API_KEY=$(get_api_key)

  local cleaned_phone
  # shellcheck disable=SC2154
  cleaned_phone=$(echo "${argc_phone}" | tr -d '().-' | tr -s ' ')

  local params
  params=$(build_search_params)
  params+="&phone=$(url_encode "$cleaned_phone")"

  local response
  response=$(make_request "GET" "$params")
  format_response "$response"
}

# @cmd Search by username
# @arg username! "Username (minimum 3 characters)"
username() {
  setup_colors
  API_KEY=$(get_api_key)

  # shellcheck disable=SC2154
  if [[ ${#argc_username} -lt 3 ]]; then
    echo "${red}Error:${reset} Username must be at least 3 characters" >&2
    exit 1
  fi

  local params
  params=$(build_search_params)
  params+="&username=${argc_username}"

  local response
  response=$(make_request "GET" "$params")
  format_response "$response"
}

# @cmd Search by social media URL
# @arg url! "Social media profile URL"
url() {
  setup_colors
  API_KEY=$(get_api_key)

  local params
  params=$(build_search_params)
  # shellcheck disable=SC2154
  params+="&url=$(url_encode "${argc_url}")"

  local response
  response=$(make_request "GET" "$params")
