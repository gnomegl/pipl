# Function to follow search_id for additional results
# Format response without following search pointers (to avoid recursion)
format_single_response() {
  local response="$1"
  local persons_count
  local search_id
  local available_sources
  local visible_sources
  
  persons_count=$(echo "$response" | jq -r '.["@persons_count"] // 0')
  search_id=$(echo "$response" | jq -r '.["@search_id"] // "N/A"')
  available_sources=$(echo "$response" | jq -r '.["@available_sources"] // 0')
  visible_sources=$(echo "$response" | jq -r '.["@visible_sources"] // 0')

  # Print search metadata
  printf "${dim}Search ID: %s | Sources: %s available, %s visible${reset}\n\n" \
    "$search_id" "$available_sources" "$visible_sources"

  # Process exact match person
  local person_data
  person_data=$(echo "$response" | jq -r '.person // empty')
  if [ -n "$person_data" ] && [ "$person_data" != "null" ]; then
    printf "${bold}${green}EXACT MATCH (from follow-up)${reset}\n"
    printf "${bold}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${reset}\n\n"
    format_single_person "$person_data" "exact"
  fi

  # Process possible persons
  local possible_persons
  possible_persons=$(echo "$response" | jq -r '.possible_persons[]? // empty')
  if [ -n "$possible_persons" ]; then
    printf "\n${bold}${yellow}POSSIBLE MATCHES (from follow-up)${reset}\n"
    printf "${bold}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${reset}\n\n"

    local count=1
    echo "$response" | jq -c '.possible_persons[]?' | while read -r person; do
      printf "${bold}Possible Match #%s${reset}\n" "$count"
      format_single_person "$person" "possible"
      printf "\n"
      count=$((count + 1))
    done
  fi
}

follow_search_pointer() {
  local search_pointer="$1"
  local follow_count="$2"
  
  if [ -z "$search_pointer" ] || [ "$search_pointer" = "N/A" ]; then
    return 0
  fi
  
  if [ "$follow_count" -gt 5 ]; then
    # Maximum follow depth reached
    return 0
  fi
  
  # Following search pointer silently
  
  # Build params for search pointer follow-up
  local config_params=""
  [ -n "$argc_minimum_probability" ] && config_params="${config_params}&minimum_probability=${argc_minimum_probability}"
  [ -n "$argc_minimum_match" ] && config_params="${config_params}&minimum_match=${argc_minimum_match}"
  [ -n "$argc_show_sources" ] && config_params="${config_params}&show_sources=${argc_show_sources}"
  if [ "$argc_live_feeds" = 1 ]; then
    config_params="${config_params}&live_feeds=true"
  fi
  [ -n "$argc_match_requirements" ] && config_params="${config_params}&match_requirements=${argc_match_requirements}"
  [ -n "$argc_source_category_requirements" ] && config_params="${config_params}&source_category_requirements=${argc_source_category_requirements}"
  # Default to top_match=true unless --no-top-match is specified
  if [ "$argc_no_top_match" != 1 ]; then
    config_params="${config_params}&top_match=true"
  fi
  [ "$argc_hide_sponsored" = 1 ] && config_params="${config_params}&hide_sponsored=true"
  
  # Use search pointer (sp) parameter for follow-up searches
  local data="sp=${search_pointer}"
  local follow_response
  
  follow_response=$(make_request "POST" "$config_params" "$data")
  
  if [ -n "$follow_response" ]; then
    echo "$follow_response" | jq
    
    # Check if there's another search pointer to follow recursively
    local next_search_pointer
    next_search_pointer=$(echo "$follow_response" | jq -r '.person["@search_pointer"] // .possible_persons[0]["@search_pointer"] // empty')
    if [ -n "$next_search_pointer" ] && [ "$next_search_pointer" != "N/A" ] && [ "$next_search_pointer" != "$search_pointer" ]; then
      follow_search_pointer "$next_search_pointer" $((follow_count + 1))
    fi
  fi
}

# Main command processing
if [ -z "$argc_command" ]; then
  show_help
  exit 0
fi

case "$argc_command" in
people)
  # Validate that at least one search parameter is provided
  if [ -z "$argc_first_name$argc_last_name$argc_raw_name$argc_username$argc_user_id$argc_url$argc_city$argc_state$argc_country$argc_raw_address$argc_age" ]; then
    echo "${red}Error:${reset} At least one search parameter is required." >&2
    echo "Use name, username, user_id, url, address, or age." >&2
    exit 1
  fi

  params=$(build_search_params)
  response=$(make_request "GET" "$params")
  echo "$response" | jq
  ;;

email)
  # For email command, use the positional argument as email
  if [ -z "$argc_value" ]; then
    echo "${red}Error:${reset} Email address is required as positional argument." >&2
    echo "Usage: $(basename "$0") email <email-address>" >&2
    exit 1
  fi
  # Set the email parameter and clear other search parameters to avoid conflicts
  argc_email="$argc_value"
  argc_first_name="" argc_last_name="" argc_phone="" argc_username="" argc_user_id="" argc_url="" argc_city="" argc_state="" argc_country="" argc_raw_address="" argc_age="" argc_raw_name="" argc_middle_name="" argc_house="" argc_street="" argc_zipcode=""

  params=$(build_search_params)
  response=$(make_request "GET" "$params")
  echo "$response" | jq
  ;;

phone)
  # For phone command, use the positional argument as phone
  if [ -z "$argc_value" ]; then
    echo "${red}Error:${reset} Phone number is required as positional argument." >&2
    echo "Usage: $(basename "$0") phone <phone-number>" >&2
    exit 1
  fi
  # Set the phone parameter and clear other search parameters to avoid conflicts
  argc_phone="$argc_value"
  argc_first_name="" argc_last_name="" argc_email="" argc_username="" argc_user_id="" argc_url="" argc_city="" argc_state="" argc_country="" argc_raw_address="" argc_age="" argc_raw_name="" argc_middle_name="" argc_house="" argc_street="" argc_zipcode=""

  params=$(build_search_params)
  response=$(make_request "GET" "$params")
  echo "$response" | jq
  ;;

pointer)
  # For pointer command, use positional argument or --search-pointer flag
  search_pointer="$argc_value"
  if [ -z "$search_pointer" ] && [ -n "$argc_search_pointer" ]; then
    search_pointer="$argc_search_pointer"
  fi
  
  if [ -z "$search_pointer" ]; then
    echo "${red}Error:${reset} Search pointer is required as positional argument or --search-pointer flag." >&2
    echo "Usage: $(basename "$0") pointer <search-pointer>" >&2
    exit 1
  fi

  config_params=""
  [ -n "$argc_minimum_probability" ] && config_params="${config_params}&minimum_probability=${argc_minimum_probability}"
  [ -n "$argc_minimum_match" ] && config_params="${config_params}&minimum_match=${argc_minimum_match}"
  [ -n "$argc_show_sources" ] && config_params="${config_params}&show_sources=${argc_show_sources}"
  if [ "$argc_live_feeds" = 1 ]; then
    config_params="${config_params}&live_feeds=true"
  fi
  [ -n "$argc_match_requirements" ] && config_params="${config_params}&match_requirements=${argc_match_requirements}"
  [ -n "$argc_source_category_requirements" ] && config_params="${config_params}&source_category_requirements=${argc_source_category_requirements}"
  # Default to top_match=true unless --no-top-match is specified
  if [ "$argc_no_top_match" != 1 ]; then
    config_params="${config_params}&top_match=true"
  fi
  [ "$argc_hide_sponsored" = 1 ] && config_params="${config_params}&hide_sponsored=true"

  data="sp=${search_pointer}"
  response=$(make_request "POST" "$config_params" "$data")
  echo "$response" | jq
  ;;

person-json)
  # For person-json command, use positional argument or --person-json flag
  person_json="$argc_value"
  if [ -z "$person_json" ] && [ -n "$argc_person_json" ]; then
    person_json="$argc_person_json"
  fi
  
  if [ -z "$person_json" ]; then
    echo "${red}Error:${reset} Person JSON string is required as positional argument or --person-json flag." >&2
    echo "Usage: $(basename "$0") person-json <json-string>" >&2
    echo "Example: $(basename "$0") person-json '{\"names\":[{\"first\":\"John\",\"last\":\"Doe\"}]}'" >&2
    exit 1
  fi

  # Validate JSON
  if ! echo "$person_json" | jq . >/dev/null 2>&1; then
    echo "${red}Error:${reset} Invalid JSON in person parameter." >&2
    exit 1
  fi

  config_params=""
  [ -n "$argc_minimum_probability" ] && config_params="${config_params}&minimum_probability=${argc_minimum_probability}"
  [ -n "$argc_minimum_match" ] && config_params="${config_params}&minimum_match=${argc_minimum_match}"
  [ -n "$argc_show_sources" ] && config_params="${config_params}&show_sources=${argc_show_sources}"
  if [ "$argc_live_feeds" = 1 ]; then
    config_params="${config_params}&live_feeds=true"
  fi
  [ -n "$argc_match_requirements" ] && config_params="${config_params}&match_requirements=${argc_match_requirements}"
  [ -n "$argc_source_category_requirements" ] && config_params="${config_params}&source_category_requirements=${argc_source_category_requirements}"
  # Default to top_match=true unless --no-top-match is specified
  if [ "$argc_no_top_match" != 1 ]; then
    config_params="${config_params}&top_match=true"
  fi
  [ "$argc_hide_sponsored" = 1 ] && config_params="${config_params}&hide_sponsored=true"

  # URL encode the JSON
  encoded_person=$(printf '%s' "$person_json" | sed 's/ /%20/g; s/"/%22/g; s/{/%7B/g; s/}/%7D/g; s/\[/%5B/g; s/\]/%5D/g; s/:/%3A/g; s/,/%2C/g')
  data="person=${encoded_person}"
  response=$(make_request "POST" "$config_params" "$data")
  echo "$response" | jq
  ;;

*)
  echo "${red}Error:${reset} Unknown command: ${argc_command}" >&2
  show_help
  exit 1
  ;;
esac

