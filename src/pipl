format_person_response() {
  local response="$1"
  local persons_count
  local search_id
  local available_sources
  local visible_sources
  
  persons_count=$(echo "$response" | jq -r '.["@persons_count"] // 0')
  search_id=$(echo "$response" | jq -r '.["@search_id"] // "N/A"')
  available_sources=$(echo "$response" | jq -r '.["@available_sources"] // 0')
  visible_sources=$(echo "$response" | jq -r '.["@visible_sources"] // 0')

  # Print search metadata
  printf "${dim}Search ID: %s | Sources: %s available, %s visible${reset}\n\n" \
    "$search_id" "$available_sources" "$visible_sources"

  # Show available data summary
  local premium_data
  premium_data=$(echo "$response" | jq -r '.available_data.premium // {}')
  if [ "$premium_data" != "{}" ]; then
    print_section "Available Data Summary"
    echo "$premium_data" | jq -r 'to_entries[] | select(.value > 0) | "\(.key)|\(.value)"' | \
      while IFS="|" read -r key value; do
        local formatted_key
        formatted_key=$(echo "$key" | sed 's/_/ /g' | sed 's/\b\w/\U&/g')
        printf "  ${cyan}%s:${reset} ${yellow}%s${reset}\n" "$formatted_key" "$value"
      done
    echo ""
  fi

  # Process exact match person
  local person_data
  person_data=$(echo "$response" | jq -r '.person // empty')
  if [ -n "$person_data" ] && [ "$person_data" != "null" ]; then
    printf "${bold}${green}EXACT MATCH${reset}\n"
    printf "${bold}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${reset}\n\n"
    format_single_person "$person_data" "exact"
  fi

  # Process possible persons
  local possible_persons
  possible_persons=$(echo "$response" | jq -r '.possible_persons[]? // empty')
  if [ -n "$possible_persons" ]; then
    printf "\n${bold}${yellow}POSSIBLE MATCHES${reset}\n"
    printf "${bold}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${reset}\n\n"

    local count=1
    echo "$response" | jq -c '.possible_persons[]?' | while read -r person; do
      printf "${bold}Possible Match #%s${reset}\n" "$count"
      format_single_person "$person" "possible"
      printf "\n"
      count=$((count + 1))
    done
  fi

  # Show warnings if any
  local warnings
  warnings=$(echo "$response" | jq -r '.warnings[]? // empty')
  if [ -n "$warnings" ]; then
    print_section "Warnings"
    echo "$warnings" | while read -r warning; do
      printf "  ${yellow}•${reset} %s\n" "$warning"
    done
  fi
  
  # Check for search pointer in the response and follow it
  local search_pointer
  search_pointer=$(echo "$response" | jq -r '.person["@search_pointer"] // .possible_persons[0]["@search_pointer"] // empty')
  if [ -n "$search_pointer" ] && [ "$search_pointer" != "N/A" ]; then
    # Only follow if we have possible persons without an exact match
    local has_exact_match
    has_exact_match=$(echo "$response" | jq -r '.person // empty')
    if [ -z "$has_exact_match" ] || [ "$has_exact_match" = "null" ]; then
      follow_search_pointer "$search_pointer" 1
    fi
  fi
}

format_single_person() {
  local person_data="$1"
  local match_type="$2"

  local match_score
  local search_pointer
  
  match_score=$(echo "$person_data" | jq -r '.["@match"] // "N/A"')
  search_pointer=$(echo "$person_data" | jq -r '.["@search_pointer"] // "N/A"')

  if [ "$match_type" = "possible" ] && [ "$match_score" != "N/A" ]; then
    printf "${bold}Match Score:${reset} ${yellow}%.2f${reset}\n" "$match_score"
  fi

  # Names
  local names
  names=$(echo "$person_data" | jq -r '.names[]? // empty')
  if [ -n "$names" ]; then
    print_section "Names"
    echo "$person_data" | jq -r '.names[] | "\(.prefix // "")|\(.first // "")|\(.middle // "")|\(.last // "")|\(.display // "")"' | \
      while IFS="|" read -r prefix first middle last display; do
        printf "  "
        [ -n "$prefix" ] && printf "${blue}%s ${reset}" "$prefix"
        [ -n "$first" ] && printf "${green}%s${reset}" "$first"
        [ -n "$middle" ] && printf " ${green}%s${reset}" "$middle"
        [ -n "$last" ] && printf " ${green}%s${reset}" "$last"
        [ -n "$display" ] && [ "$display" != "$first $middle $last" ] && printf " ${dim}(%s)${reset}" "$display"
        printf "\n"
      done
  fi

  # Gender and DOB
  local gender
  local dob_display
  
  gender=$(echo "$person_data" | jq -r '.gender.content // "N/A"')
  dob_display=$(echo "$person_data" | jq -r '.dob.display // "N/A"')

  if [ "$gender" != "N/A" ] || [ "$dob_display" != "N/A" ]; then
    print_section "Personal Info"
    [ "$gender" != "N/A" ] && printf "  ${cyan}Gender:${reset} ${magenta}%s${reset}\n" "$gender"
    [ "$dob_display" != "N/A" ] && printf "  ${cyan}Date of Birth:${reset} ${yellow}%s${reset}\n" "$dob_display"
  fi

  # Phones
  local phones
  phones=$(echo "$person_data" | jq -r '.phones[]? // empty')
  if [ -n "$phones" ]; then
    print_section "Phone Numbers"
    echo "$person_data" | jq -r '.phones[] | "\(.["@type"] // "unknown")|\(.display_international // .display // "N/A")"' | \
      while IFS="|" read -r type display; do
        local type_formatted
        type_formatted=$(echo "$type" | sed 's/\b\w/\U&/g')
        printf "  ${cyan}%s:${reset} ${blue}%s${reset}\n" "$type_formatted" "$display"
      done
  fi

  # Addresses
  local addresses
  addresses=$(echo "$person_data" | jq -r '.addresses[]? // empty')
  if [ -n "$addresses" ]; then
    print_section "Addresses"
    echo "$person_data" | jq -r '.addresses[] | "\(.display // "")"' | \
      while read -r address; do
        [ -n "$address" ] && printf "  ${magenta}%s${reset}\n" "$address"
      done
  fi

  # Jobs
  local jobs
  jobs=$(echo "$person_data" | jq -r '.jobs[]? // empty')
  if [ -n "$jobs" ]; then
    print_section "Employment"
    echo "$person_data" | jq -r '.jobs[] | "\(.title // "")|\(.organization // "")|\(.display // "")"' | \
      while IFS="|" read -r title org display; do
        printf "  "
        [ -n "$title" ] && printf "${yellow}%s${reset}" "$title"
        [ -n "$title" ] && [ -n "$org" ] && printf " at "
        [ -n "$org" ] && printf "${blue}%s${reset}" "$org"
        [ -n "$display" ] && [ "$display" != "$title $org" ] && printf " ${dim}(%s)${reset}" "$display"
        printf "\n"
      done
  fi

  # Education
  local educations
  educations=$(echo "$person_data" | jq -r '.educations[]? // empty')
  if [ -n "$educations" ]; then
    print_section "Education"
    echo "$person_data" | jq -r '.educations[] | "\(.degree // "")|\(.school // "")|\(.display // "")"' | \
      while IFS="|" read -r degree school display; do
        printf "  "
        [ -n "$degree" ] && printf "${yellow}%s${reset}" "$degree"
        [ -n "$degree" ] && [ -n "$school" ] && printf " from "
        [ -n "$school" ] && printf "${blue}%s${reset}" "$school"
        [ -n "$display" ] && [ "$display" != "$degree $school" ] && printf " ${dim}(%s)${reset}" "$display"
        printf "\n"
      done
  fi

  # Usernames
  local usernames
  usernames=$(echo "$person_data" | jq -r '.usernames[]? // empty')
  if [ -n "$usernames" ]; then
    print_section "Usernames"
    echo "$person_data" | jq -r '.usernames[].content // empty' | \
      while read -r username; do
        printf "  ${cyan}@%s${reset}\n" "$username"
      done
  fi

  # User IDs
  local user_ids
  user_ids=$(echo "$person_data" | jq -r '.user_ids[]? // empty')
  if [ -n "$user_ids" ]; then
    print_section "Social Media IDs"
    echo "$person_data" | jq -r '.user_ids[].content // empty' | \
      while read -r user_id; do
        printf "  ${blue}%s${reset}\n" "$user_id"
      done
  fi

  # Images
  local images
  images=$(echo "$person_data" | jq -r '.images[]? // empty')
  if [ -n "$images" ]; then
    print_section "Profile Images"
    echo "$person_data" | jq -r '.images[].url // empty' | \
      while read -r url; do
        printf "  ${blue}%s${reset}\n" "$url"
      done
  fi

  # Relationships
  local relationships
  relationships=$(echo "$person_data" | jq -r '.relationships[]? // empty')
  if [ -n "$relationships" ]; then
    print_section "Relationships"
    echo "$person_data" | jq -r '.relationships[] | "\(.["@type"] // "")|\(.["@subtype"] // "")|\(.names[0].display // (.names[0].first + " " + .names[0].last) // "")"' | \
      while IFS="|" read -r type subtype name; do
        printf "  ${cyan}%s" "$type"
        [ -n "$subtype" ] && printf " (%s)" "$subtype"
        printf ":${reset} ${green}%s${reset}\n" "$name"
      done
  fi

  # Languages
  local languages
  languages=$(echo "$person_data" | jq -r '.languages[]? // empty')
  if [ -n "$languages" ]; then
    print_section "Languages"
    echo "$person_data" | jq -r '.languages[] | "\(.language // "")|\(.region // "")"' | \
      while IFS="|" read -r language region; do
        printf "  ${magenta}%s${reset}" "$language"
        [ -n "$region" ] && printf " ${dim}(%s)${reset}" "$region"
        printf "\n"
      done
  fi

  # Search pointer for follow-up searches
  if [ "$search_pointer" != "N/A" ] && [ "$match_type" = "possible" ]; then
    print_section "Follow-up Search"
    printf "  ${dim}Use: $(basename "$0") pointer --search-pointer '%s'${reset}\n" "${search_pointer:0:50}..."
  fi
}

