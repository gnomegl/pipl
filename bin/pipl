#!/usr/bin/env bash

# @describe PIPL Search API client for people intelligence and data enrichment
# @arg command "Command to run (people, email, phone, pointer, person-json)" [string]
# @arg value "Email address for email command, phone number for phone command, search pointer for pointer command, person JSON for person-json command" [string]

# Global options (available for all commands)
# @option -k --key "PIPL API key (can also use PIPL_API_KEY env var)" [string]
# @flag   -j --json "Deprecated - JSON is now the default output"
# @flag   -q --quiet "Suppress colored output"


# Search configuration options (available for all search commands)
# @option --minimum-probability "Minimum acceptable probability for inferred data (0-1)" [float] @default "0.9"
# @option --minimum-match "Minimum required match score for possible persons (0-1)" [float] @default "0"
# @option --show-sources "Sources to show (true, false, all, matching)" [string] @default "false"
# @flag   --live-feeds "Whether to use live data sources"
# @option --match-requirements "Fields that must be present in response" [string]
# @option --source-category-requirements "Source categories that must be present" [string]
# @flag   --no-top-match "Return all matches instead of just the top match (default: top match only)"
# @flag   --hide-sponsored "Omit sponsored results"

# People search parameters (only available for 'people' command)
# @option -f --first-name "First name or given name" [string]
# @option -m --middle-name "Middle name" [string]
# @option -l --last-name "Last name or family name" [string]
# @option --raw-name "Full name (use if not parsed into components)" [string]
# @option --house "House number" [string]
# @option --street "Street portion of address" [string]
# @option -c --city "City" [string]
# @option -s --state "State or province" [string]
# @option -z --zipcode "Zipcode or postal code" [string]
# @option --country "Country ISO Alpha 2-Code" [string]
# @option --raw-address "Full address (use if not parsed into components)" [string]
# @option -a --age "Exact (YY) or approximate (YY-YY) age" [string]
# @option -u --username "Username (minimum 3 characters)" [string]
# @option --user-id "User ID with service name (e.g. 11231@facebook)" [string]
# @option --url "Social media profile URL" [string]
# @meta require-tools curl,jq

# ARGC-BUILD {
# This block was generated by argc (https://github.com/sigoden/argc).
# Modifying it manually is not recommended

_argc_run() {
    if [[ "${1:-}" == "___internal___" ]]; then
        _argc_die "error: unsupported ___internal___ command"
    fi
    if [[ "${OS:-}" == "Windows_NT" ]] && [[ -n "${MSYSTEM:-}" ]]; then
        set -o igncr
    fi
    argc__args=("$(basename "$0" .sh)" "$@")
    argc__positionals=()
    _argc_index=1
    _argc_len="${#argc__args[@]}"
    _argc_tools=()
    _argc_parse
    _argc_require_tools "${_argc_tools[@]}"
    if [ -n "${argc__fn:-}" ]; then
        $argc__fn "${argc__positionals[@]}"
    fi
}

_argc_usage() {
    cat <<-'EOF'
PIPL Search API client for people intelligence and data enrichment

USAGE: pipl [OPTIONS] [COMMAND] [VALUE]

ARGS:
  [COMMAND]  "Command to run (people, email, phone, pointer, person-json)" [string]
  [VALUE]    "Email address for email command, phone number for phone command, search pointer for pointer command, person JSON for person-json command" [string]

OPTIONS:
  -k, --key <KEY>                                                    "PIPL API key (can also use PIPL_API_KEY env var)" [string]
  -j, --json                                                         "Deprecated - JSON is now the default output"
  -q, --quiet                                                        "Suppress colored output"
      --minimum-probability <MINIMUM-PROBABILITY>                    "Minimum acceptable probability for inferred data (0-1)" [float] @default "0.9"
      --minimum-match <MINIMUM-MATCH>                                "Minimum required match score for possible persons (0-1)" [float] @default "0"
      --show-sources <SHOW-SOURCES>                                  "Sources to show (true, false, all, matching)" [string] @default "false"
      --live-feeds                                                   "Whether to use live data sources"
      --match-requirements <MATCH-REQUIREMENTS>                      "Fields that must be present in response" [string]
      --source-category-requirements <SOURCE-CATEGORY-REQUIREMENTS>  "Source categories that must be present" [string]
      --no-top-match                                                 "Return all matches instead of just the top match (default: top match only)"
      --hide-sponsored                                               "Omit sponsored results"
  -f, --first-name <FIRST-NAME>                                      "First name or given name" [string]
  -m, --middle-name <MIDDLE-NAME>                                    "Middle name" [string]
  -l, --last-name <LAST-NAME>                                        "Last name or family name" [string]
      --raw-name <RAW-NAME>                                          "Full name (use if not parsed into components)" [string]
      --house <HOUSE>                                                "House number" [string]
      --street <STREET>                                              "Street portion of address" [string]
  -c, --city <CITY>                                                  "City" [string]
  -s, --state <STATE>                                                "State or province" [string]
  -z, --zipcode <ZIPCODE>                                            "Zipcode or postal code" [string]
      --country <COUNTRY>                                            "Country ISO Alpha 2-Code" [string]
      --raw-address <RAW-ADDRESS>                                    "Full address (use if not parsed into components)" [string]
  -a, --age <AGE>                                                    "Exact (YY) or approximate (YY-YY) age" [string]
  -u, --username <USERNAME>                                          "Username (minimum 3 characters)" [string]
      --user-id <USER-ID>                                            "User ID with service name (e.g. 11231@facebook)" [string]
      --url <URL>                                                    "Social media profile URL" [string]
  -h, --help                                                         Print help
  -V, --version                                                      Print version
EOF
    exit
}

_argc_version() {
    echo pipl 0.0.0
    exit
}

_argc_parse() {
    local _argc_key _argc_action
    local _argc_subcmds=""
    while [[ $_argc_index -lt $_argc_len ]]; do
        _argc_item="${argc__args[_argc_index]}"
        _argc_key="${_argc_item%%=*}"
        case "$_argc_key" in
        --help | -help | -h)
            _argc_usage
            ;;
        --version | -version | -V)
            _argc_version
            ;;
        --)
            _argc_dash="${#argc__positionals[@]}"
            argc__positionals+=("${argc__args[@]:$((_argc_index + 1))}")
            _argc_index=$_argc_len
            break
            ;;
        --key | -k)
            _argc_take_args "--key <KEY>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_key:-}" ]]; then
                argc_key="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--key\` cannot be used multiple times"
            fi
            ;;
        --json | -j)
            if [[ "$_argc_item" == *=* ]]; then
                _argc_die "error: flag \`--json\` don't accept any value"
            fi
            _argc_index=$((_argc_index + 1))
            if [[ -n "${argc_json:-}" ]]; then
                _argc_die "error: the argument \`--json\` cannot be used multiple times"
            else
                argc_json=1
            fi
            ;;
        --quiet | -q)
            if [[ "$_argc_item" == *=* ]]; then
                _argc_die "error: flag \`--quiet\` don't accept any value"
            fi
            _argc_index=$((_argc_index + 1))
            if [[ -n "${argc_quiet:-}" ]]; then
                _argc_die "error: the argument \`--quiet\` cannot be used multiple times"
            else
                argc_quiet=1
            fi
            ;;
        --minimum-probability)
            _argc_take_args "--minimum-probability <MINIMUM-PROBABILITY>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_minimum_probability:-}" ]]; then
                argc_minimum_probability="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--minimum-probability\` cannot be used multiple times"
            fi
            ;;
        --minimum-match)
            _argc_take_args "--minimum-match <MINIMUM-MATCH>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_minimum_match:-}" ]]; then
                argc_minimum_match="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--minimum-match\` cannot be used multiple times"
            fi
            ;;
        --show-sources)
            _argc_take_args "--show-sources <SHOW-SOURCES>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_show_sources:-}" ]]; then
                argc_show_sources="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--show-sources\` cannot be used multiple times"
            fi
            ;;
        --live-feeds)
            if [[ "$_argc_item" == *=* ]]; then
                _argc_die "error: flag \`--live-feeds\` don't accept any value"
            fi
            _argc_index=$((_argc_index + 1))
            if [[ -n "${argc_live_feeds:-}" ]]; then
                _argc_die "error: the argument \`--live-feeds\` cannot be used multiple times"
            else
                argc_live_feeds=1
            fi
            ;;
        --match-requirements)
            _argc_take_args "--match-requirements <MATCH-REQUIREMENTS>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_match_requirements:-}" ]]; then
                argc_match_requirements="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--match-requirements\` cannot be used multiple times"
            fi
            ;;
        --source-category-requirements)
            _argc_take_args "--source-category-requirements <SOURCE-CATEGORY-REQUIREMENTS>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_source_category_requirements:-}" ]]; then
                argc_source_category_requirements="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--source-category-requirements\` cannot be used multiple times"
            fi
            ;;
        --no-top-match)
            if [[ "$_argc_item" == *=* ]]; then
                _argc_die "error: flag \`--no-top-match\` don't accept any value"
            fi
            _argc_index=$((_argc_index + 1))
            if [[ -n "${argc_no_top_match:-}" ]]; then
                _argc_die "error: the argument \`--no-top-match\` cannot be used multiple times"
            else
                argc_no_top_match=1
            fi
            ;;
        --hide-sponsored)
            if [[ "$_argc_item" == *=* ]]; then
                _argc_die "error: flag \`--hide-sponsored\` don't accept any value"
            fi
            _argc_index=$((_argc_index + 1))
            if [[ -n "${argc_hide_sponsored:-}" ]]; then
                _argc_die "error: the argument \`--hide-sponsored\` cannot be used multiple times"
            else
                argc_hide_sponsored=1
            fi
            ;;
        --first-name | -f)
            _argc_take_args "--first-name <FIRST-NAME>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_first_name:-}" ]]; then
                argc_first_name="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--first-name\` cannot be used multiple times"
            fi
            ;;
        --middle-name | -m)
            _argc_take_args "--middle-name <MIDDLE-NAME>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_middle_name:-}" ]]; then
                argc_middle_name="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--middle-name\` cannot be used multiple times"
            fi
            ;;
        --last-name | -l)
            _argc_take_args "--last-name <LAST-NAME>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_last_name:-}" ]]; then
                argc_last_name="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--last-name\` cannot be used multiple times"
            fi
            ;;
        --raw-name)
            _argc_take_args "--raw-name <RAW-NAME>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_raw_name:-}" ]]; then
                argc_raw_name="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--raw-name\` cannot be used multiple times"
            fi
            ;;
        --house)
            _argc_take_args "--house <HOUSE>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_house:-}" ]]; then
                argc_house="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--house\` cannot be used multiple times"
            fi
            ;;
        --street)
            _argc_take_args "--street <STREET>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_street:-}" ]]; then
                argc_street="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--street\` cannot be used multiple times"
            fi
            ;;
        --city | -c)
            _argc_take_args "--city <CITY>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_city:-}" ]]; then
                argc_city="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--city\` cannot be used multiple times"
            fi
            ;;
        --state | -s)
            _argc_take_args "--state <STATE>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_state:-}" ]]; then
                argc_state="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--state\` cannot be used multiple times"
            fi
            ;;
        --zipcode | -z)
            _argc_take_args "--zipcode <ZIPCODE>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_zipcode:-}" ]]; then
                argc_zipcode="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--zipcode\` cannot be used multiple times"
            fi
            ;;
        --country)
            _argc_take_args "--country <COUNTRY>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_country:-}" ]]; then
                argc_country="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--country\` cannot be used multiple times"
            fi
            ;;
        --raw-address)
            _argc_take_args "--raw-address <RAW-ADDRESS>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_raw_address:-}" ]]; then
                argc_raw_address="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--raw-address\` cannot be used multiple times"
            fi
            ;;
        --age | -a)
            _argc_take_args "--age <AGE>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_age:-}" ]]; then
                argc_age="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--age\` cannot be used multiple times"
            fi
            ;;
        --username | -u)
            _argc_take_args "--username <USERNAME>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_username:-}" ]]; then
                argc_username="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--username\` cannot be used multiple times"
            fi
            ;;
        --user-id)
            _argc_take_args "--user-id <USER-ID>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_user_id:-}" ]]; then
                argc_user_id="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--user-id\` cannot be used multiple times"
            fi
            ;;
        --url)
            _argc_take_args "--url <URL>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_url:-}" ]]; then
                argc_url="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--url\` cannot be used multiple times"
            fi
            ;;
        *)
            if _argc_maybe_flag_option "-" "$_argc_item"; then
                _argc_die "error: unexpected argument \`$_argc_key\` found"
            fi
            argc__positionals+=("$_argc_item")
            _argc_index=$((_argc_index + 1))
            ;;
        esac
    done
    _argc_tools=(curl jq)
    if [[ -n "${_argc_action:-}" ]]; then
        $_argc_action
    else
        if [[ "${argc__positionals[0]:-}" == "help" ]] && [[ "${#argc__positionals[@]}" -eq 1 ]]; then
            _argc_usage
        fi
        _argc_match_positionals 0 0
        local values_index values_size
        IFS=: read -r values_index values_size <<<"${_argc_match_positionals_values[0]:-}"
        if [[ -n "$values_index" ]]; then
            argc_command="${argc__positionals[values_index]}"
        fi
        IFS=: read -r values_index values_size <<<"${_argc_match_positionals_values[1]:-}"
        if [[ -n "$values_index" ]]; then
            argc_value="${argc__positionals[values_index]}"
        fi
    fi
}

_argc_take_args() {
    _argc_take_args_values=()
    _argc_take_args_len=0
    local param="$1" min="$2" max="$3" signs="$4" delimiter="$5"
    if [[ "$min" -eq 0 ]] && [[ "$max" -eq 0 ]]; then
        return
    fi
    local _argc_take_index=$((_argc_index + 1)) _argc_take_value
    if [[ "$_argc_item" == *=* ]]; then
        _argc_take_args_values=("${_argc_item##*=}")
    else
        while [[ $_argc_take_index -lt $_argc_len ]]; do
            _argc_take_value="${argc__args[_argc_take_index]}"
            if _argc_maybe_flag_option "$signs" "$_argc_take_value"; then
                if [[ "${#_argc_take_value}" -gt 1 ]]; then
                    break
                fi
            fi
            _argc_take_args_values+=("$_argc_take_value")
            _argc_take_args_len=$((_argc_take_args_len + 1))
            if [[ "$_argc_take_args_len" -ge "$max" ]]; then
                break
            fi
            _argc_take_index=$((_argc_take_index + 1))
        done
    fi
    if [[ "${#_argc_take_args_values[@]}" -lt "$min" ]]; then
        _argc_die "error: incorrect number of values for \`$param\`"
    fi
    if [[ -n "$delimiter" ]] && [[ "${#_argc_take_args_values[@]}" -gt 0 ]]; then
        local item values arr=()
        for item in "${_argc_take_args_values[@]}"; do
            IFS="$delimiter" read -r -a values <<<"$item"
            arr+=("${values[@]}")
        done
        _argc_take_args_values=("${arr[@]}")
    fi
}

_argc_match_positionals() {
    _argc_match_positionals_values=()
    _argc_match_positionals_len=0
    local params=("$@")
    local args_len="${#argc__positionals[@]}"
    if [[ $args_len -eq 0 ]]; then
        return
    fi
    local params_len=$# arg_index=0 param_index=0
    while [[ $param_index -lt $params_len && $arg_index -lt $args_len ]]; do
        local takes=0
        if [[ "${params[param_index]}" -eq 1 ]]; then
            if [[ $param_index -eq 0 ]] &&
                [[ ${_argc_dash:-} -gt 0 ]] &&
                [[ $params_len -eq 2 ]] &&
                [[ "${params[$((param_index + 1))]}" -eq 1 ]] \
                ; then
                takes=${_argc_dash:-}
            else
                local arg_diff=$((args_len - arg_index)) param_diff=$((params_len - param_index))
                if [[ $arg_diff -gt $param_diff ]]; then
                    takes=$((arg_diff - param_diff + 1))
                else
                    takes=1
                fi
            fi
        else
            takes=1
        fi
        _argc_match_positionals_values+=("$arg_index:$takes")
        arg_index=$((arg_index + takes))
        param_index=$((param_index + 1))
    done
    if [[ $arg_index -lt $args_len ]]; then
        _argc_match_positionals_values+=("$arg_index:$((args_len - arg_index))")
    fi
    _argc_match_positionals_len=${#_argc_match_positionals_values[@]}
    if [[ $params_len -gt 0 ]] && [[ $_argc_match_positionals_len -gt $params_len ]]; then
        local index="${_argc_match_positionals_values[params_len]%%:*}"
        _argc_die "error: unexpected argument \`${argc__positionals[index]}\` found"
    fi
}

_argc_maybe_flag_option() {
    local signs="$1" arg="$2"
    if [[ -z "$signs" ]]; then
        return 1
    fi
    local cond=false
    if [[ "$signs" == *"+"* ]]; then
        if [[ "$arg" =~ ^\+[^+].* ]]; then
            cond=true
        fi
    elif [[ "$arg" == -* ]]; then
        if (( ${#arg} < 3 )) || [[ ! "$arg" =~ ^---.* ]]; then
            cond=true
        fi
    fi
    if [[ "$cond" == "false" ]]; then
        return 1
    fi
    local value="${arg%%=*}"
    if [[ "$value" =~ [[:space:]] ]]; then
        return 1
    fi
    return 0
}

_argc_require_tools() {
    local tool missing_tools=()
    for tool in "$@"; do
        if ! command -v "$tool" >/dev/null 2>&1; then
            missing_tools+=("$tool")
        fi
    done
    if [[ "${#missing_tools[@]}" -gt 0 ]]; then
        echo "error: missing tools: ${missing_tools[*]}" >&2
        exit 1
    fi
}

_argc_die() {
    if [[ $# -eq 0 ]]; then
        cat
    else
        echo "$*" >&2
    fi
    exit 1
}

_argc_run "$@"

# ARGC-BUILD }

# Setup colors
setup_colors() {
  if [ "${argc_quiet:-0}" = 1 ] || [ -z "$TERM" ] || [ "$TERM" = "dumb" ]; then
    bold="" reset="" blue="" green="" yellow="" cyan="" magenta="" red="" dim=""
  else
    bold=$(tput bold) reset=$(tput sgr0) blue=$(tput setaf 4) green=$(tput setaf 2)
    yellow=$(tput setaf 3) cyan=$(tput setaf 6) magenta=$(tput setaf 5) red=$(tput setaf 1)
    dim=$(tput dim)
  fi
}
setup_colors

# Get API key from multiple sources
get_api_key() {
  if [ -n "$argc_key" ]; then
    echo "$argc_key"
  elif [ -n "$PIPL_API_KEY" ]; then
    echo "$PIPL_API_KEY"
  elif [ -f "$HOME/.config/pipl/api_key" ]; then
    cat "$HOME/.config/pipl/api_key"
  else
    echo "${red}Error:${reset} No PIPL API key found." >&2
    echo "Either:" >&2
    echo "  1. Pass it with --key" >&2
    echo "  2. Set PIPL_API_KEY environment variable" >&2
    echo "  3. Save it to ~/.config/pipl/api_key" >&2
    exit 1
  fi
}
API_KEY=$(get_api_key)
API_BASE="https://api.pipl.com"

# Helper functions
print_kv() {
  printf "${bold}%s:${reset} %s\n" "$1" "$2"
}

print_section() {
  printf "\n${bold}%s:${reset}\n" "$1"
}

format_date_range() {
  local start="$1"
  local end="$2"
  if [ "$start" = "$end" ]; then
    echo "$start"
  else
    echo "${start} - ${end}"
  fi
}

make_request() {
  local method="$1"
  local params="$2"
  local data="$3"

  local url="${API_BASE}/search?key=${API_KEY}${params}"
  local response

  if [ "$method" = "GET" ]; then
    response=$(curl -s "$url")
  else
    response=$(curl -s -X POST -H "Content-Type: application/x-www-form-urlencoded" -d "$data" "$url")
  fi

  # Check for errors
  local http_status=$(echo "$response" | jq -r '.["@http_status_code"] // 200')
  if [ "$http_status" != "200" ]; then
    local error_msg=$(echo "$response" | jq -r '.error // "Unknown error"')
    printf "${red}Error (HTTP %s):${reset} %s\n" "$http_status" "$error_msg" >&2

    local warnings=$(echo "$response" | jq -r '.warnings[]? // empty' 2>/dev/null)
    if [ -n "$warnings" ]; then
      printf "${yellow}Warnings:${reset}\n" >&2
      echo "$warnings" | while read -r warning; do
        printf "  ${yellow}•${reset} %s\n" "$warning" >&2
      done
    fi
    exit 1
  fi

  echo "$response"
}

build_search_params() {
  local params=""

  # Search configuration
  [ -n "$argc_minimum_probability" ] && params="${params}&minimum_probability=${argc_minimum_probability}"
  [ -n "$argc_minimum_match" ] && params="${params}&minimum_match=${argc_minimum_match}"
  [ -n "$argc_show_sources" ] && params="${params}&show_sources=${argc_show_sources}"
  if [ "$argc_live_feeds" = 1 ]; then
    params="${params}&live_feeds=true"
  else
    params="${params}&live_feeds=false"
  fi
  [ -n "$argc_match_requirements" ] && params="${params}&match_requirements=${argc_match_requirements}"
  [ -n "$argc_source_category_requirements" ] && params="${params}&source_category_requirements=${argc_source_category_requirements}"
  # Default to top_match=true unless --no-top-match is specified
  if [ "$argc_no_top_match" != 1 ]; then
    params="${params}&top_match=true"
  fi
  [ "$argc_hide_sponsored" = 1 ] && params="${params}&hide_sponsored=true"

  # Name parameters
  [ -n "$argc_first_name" ] && params="${params}&first_name=$(printf '%s' "$argc_first_name" | sed 's/ /%20/g')"
  [ -n "$argc_middle_name" ] && params="${params}&middle_name=$(printf '%s' "$argc_middle_name" | sed 's/ /%20/g')"
  [ -n "$argc_last_name" ] && params="${params}&last_name=$(printf '%s' "$argc_last_name" | sed 's/ /%20/g')"
  [ -n "$argc_raw_name" ] && params="${params}&raw_name=$(printf '%s' "$argc_raw_name" | sed 's/ /%20/g')"

  # Address parameters
  [ -n "$argc_house" ] && params="${params}&house=$(printf '%s' "$argc_house" | sed 's/ /%20/g')"
  [ -n "$argc_street" ] && params="${params}&street=$(printf '%s' "$argc_street" | sed 's/ /%20/g')"
  [ -n "$argc_city" ] && params="${params}&city=$(printf '%s' "$argc_city" | sed 's/ /%20/g')"
  [ -n "$argc_state" ] && params="${params}&state=$(printf '%s' "$argc_state" | sed 's/ /%20/g')"
  [ -n "$argc_zipcode" ] && params="${params}&zipcode=${argc_zipcode}"
  [ -n "$argc_country" ] && params="${params}&country=${argc_country}"
  [ -n "$argc_raw_address" ] && params="${params}&raw_address=$(printf '%s' "$argc_raw_address" | sed 's/ /%20/g')"

  # Other parameters
  [ -n "$argc_age" ] && params="${params}&age=${argc_age}"
  [ -n "$argc_username" ] && params="${params}&username=${argc_username}"
  [ -n "$argc_user_id" ] && params="${params}&user_id=${argc_user_id}"
  [ -n "$argc_url" ] && params="${params}&url=$(printf '%s' "$argc_url" | sed 's/&/%26/g')"
  [ -n "$argc_email" ] && params="${params}&email=$(printf '%s' "$argc_email" | sed 's/@/%40/g; s/\./%2E/g')"
  [ -n "$argc_phone" ] && params="${params}&phone=$(printf '%s' "$argc_phone" | sed 's/ /%20/g; s/+/%2B/g')"

  echo "$params"
}

show_help() {
  echo "${bold}PIPL Search API Client${reset}"
  echo ""
  echo "${bold}Commands:${reset}"
  echo "  ${cyan}people${reset}     Search for a person using various parameters"
  echo "  ${cyan}email${reset}     Search by email address"
  echo "  ${cyan}phone${reset}     Search by phone number"
  echo "  ${cyan}pointer${reset}   Search using a search pointer from previous results"
  echo "  ${cyan}person-json${reset}    Search using a JSON person object"
  echo ""
  echo "${bold}Examples:${reset}"
  echo "  ${green}$(basename "$0") people -f John -l Doe -c Boston${reset}"
  echo "  ${green}$(basename "$0") email john.doe@example.com${reset}"
  echo "  ${green}$(basename "$0") phone '+1(555)123-4567'${reset}"
  echo "  ${green}$(basename "$0") pointer 'abc123...'${reset}"
  echo "  ${green}$(basename "$0") person-json '{\"names\":[{\"first\":\"John\"}]}'${reset}"
  echo "  ${green}$(basename "$0") email john.doe@example.com${reset}"
  echo ""
  echo "${bold}Global Options:${reset}"
  echo "  ${yellow}-k, --key${reset}                    PIPL API key"
  echo "  ${yellow}-j, --json${reset}                   Deprecated - JSON is now the default output"
  echo "  ${yellow}-q, --quiet${reset}                  Suppress colored output"

  echo ""
  echo "${bold}Search Configuration:${reset}"
  echo "  ${yellow}--minimum-probability${reset}        Minimum probability for inferred data (0-1)"
  echo "  ${yellow}--minimum-match${reset}              Minimum match score (0-1)"
  echo "  ${yellow}--no-top-match${reset}               Return all matches (default: top match only)"
  echo "  ${yellow}--show-sources${reset}               Show data sources (true, false, all, matching)"
  echo "  ${yellow}--live-feeds${reset}                 Use live data sources"
  echo "  ${yellow}--hide-sponsored${reset}             Omit sponsored results"
  echo ""
  echo "${bold}Auto-follow Feature:${reset}"
  echo "  For possible matches without exact results, the tool can follow search pointers"
  echo "  to retrieve additional data about those persons. This uses additional API calls."
  echo "  Maximum follow depth is 5 levels to prevent infinite loops."
}

format_person_response() {
  local response="$1"
  local persons_count
  local search_id
  local available_sources
  local visible_sources
  
  persons_count=$(echo "$response" | jq -r '.["@persons_count"] // 0')
  search_id=$(echo "$response" | jq -r '.["@search_id"] // "N/A"')
  available_sources=$(echo "$response" | jq -r '.["@available_sources"] // 0')
  visible_sources=$(echo "$response" | jq -r '.["@visible_sources"] // 0')

  # Print search metadata
  printf "${dim}Search ID: %s | Sources: %s available, %s visible${reset}\n\n" \
    "$search_id" "$available_sources" "$visible_sources"

  # Show available data summary
  local premium_data
  premium_data=$(echo "$response" | jq -r '.available_data.premium // {}')
  if [ "$premium_data" != "{}" ]; then
    print_section "Available Data Summary"
    echo "$premium_data" | jq -r 'to_entries[] | select(.value > 0) | "\(.key)|\(.value)"' | \
      while IFS="|" read -r key value; do
        local formatted_key
        formatted_key=$(echo "$key" | sed 's/_/ /g' | sed 's/\b\w/\U&/g')
        printf "  ${cyan}%s:${reset} ${yellow}%s${reset}\n" "$formatted_key" "$value"
      done
    echo ""
  fi

  # Process exact match person
  local person_data
  person_data=$(echo "$response" | jq -r '.person // empty')
  if [ -n "$person_data" ] && [ "$person_data" != "null" ]; then
    printf "${bold}${green}EXACT MATCH${reset}\n"
    printf "${bold}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${reset}\n\n"
    format_single_person "$person_data" "exact"
  fi

  # Process possible persons
  local possible_persons
  possible_persons=$(echo "$response" | jq -r '.possible_persons[]? // empty')
  if [ -n "$possible_persons" ]; then
    printf "\n${bold}${yellow}POSSIBLE MATCHES${reset}\n"
    printf "${bold}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${reset}\n\n"

    local count=1
    echo "$response" | jq -c '.possible_persons[]?' | while read -r person; do
      printf "${bold}Possible Match #%s${reset}\n" "$count"
      format_single_person "$person" "possible"
      printf "\n"
      count=$((count + 1))
    done
  fi

  # Show warnings if any
  local warnings
  warnings=$(echo "$response" | jq -r '.warnings[]? // empty')
  if [ -n "$warnings" ]; then
    print_section "Warnings"
    echo "$warnings" | while read -r warning; do
      printf "  ${yellow}•${reset} %s\n" "$warning"
    done
  fi
  
  # Check for search pointer in the response and follow it
  local search_pointer
  search_pointer=$(echo "$response" | jq -r '.person["@search_pointer"] // .possible_persons[0]["@search_pointer"] // empty')
  if [ -n "$search_pointer" ] && [ "$search_pointer" != "N/A" ]; then
    # Only follow if we have possible persons without an exact match
    local has_exact_match
    has_exact_match=$(echo "$response" | jq -r '.person // empty')
    if [ -z "$has_exact_match" ] || [ "$has_exact_match" = "null" ]; then
      follow_search_pointer "$search_pointer" 1
    fi
  fi
}

format_single_person() {
  local person_data="$1"
  local match_type="$2"

  local match_score
  local search_pointer
  
  match_score=$(echo "$person_data" | jq -r '.["@match"] // "N/A"')
  search_pointer=$(echo "$person_data" | jq -r '.["@search_pointer"] // "N/A"')

  if [ "$match_type" = "possible" ] && [ "$match_score" != "N/A" ]; then
    printf "${bold}Match Score:${reset} ${yellow}%.2f${reset}\n" "$match_score"
  fi

  # Names
  local names
  names=$(echo "$person_data" | jq -r '.names[]? // empty')
  if [ -n "$names" ]; then
    print_section "Names"
    echo "$person_data" | jq -r '.names[] | "\(.prefix // "")|\(.first // "")|\(.middle // "")|\(.last // "")|\(.display // "")"' | \
      while IFS="|" read -r prefix first middle last display; do
        printf "  "
        [ -n "$prefix" ] && printf "${blue}%s ${reset}" "$prefix"
        [ -n "$first" ] && printf "${green}%s${reset}" "$first"
        [ -n "$middle" ] && printf " ${green}%s${reset}" "$middle"
        [ -n "$last" ] && printf " ${green}%s${reset}" "$last"
        [ -n "$display" ] && [ "$display" != "$first $middle $last" ] && printf " ${dim}(%s)${reset}" "$display"
        printf "\n"
      done
  fi

  # Gender and DOB
  local gender
  local dob_display
  
  gender=$(echo "$person_data" | jq -r '.gender.content // "N/A"')
  dob_display=$(echo "$person_data" | jq -r '.dob.display // "N/A"')

  if [ "$gender" != "N/A" ] || [ "$dob_display" != "N/A" ]; then
    print_section "Personal Info"
    [ "$gender" != "N/A" ] && printf "  ${cyan}Gender:${reset} ${magenta}%s${reset}\n" "$gender"
    [ "$dob_display" != "N/A" ] && printf "  ${cyan}Date of Birth:${reset} ${yellow}%s${reset}\n" "$dob_display"
  fi

  # Phones
  local phones
  phones=$(echo "$person_data" | jq -r '.phones[]? // empty')
  if [ -n "$phones" ]; then
    print_section "Phone Numbers"
    echo "$person_data" | jq -r '.phones[] | "\(.["@type"] // "unknown")|\(.display_international // .display // "N/A")"' | \
      while IFS="|" read -r type display; do
        local type_formatted
        type_formatted=$(echo "$type" | sed 's/\b\w/\U&/g')
        printf "  ${cyan}%s:${reset} ${blue}%s${reset}\n" "$type_formatted" "$display"
      done
  fi

  # Addresses
  local addresses
  addresses=$(echo "$person_data" | jq -r '.addresses[]? // empty')
  if [ -n "$addresses" ]; then
    print_section "Addresses"
    echo "$person_data" | jq -r '.addresses[] | "\(.display // "")"' | \
      while read -r address; do
        [ -n "$address" ] && printf "  ${magenta}%s${reset}\n" "$address"
      done
  fi

  # Jobs
  local jobs
  jobs=$(echo "$person_data" | jq -r '.jobs[]? // empty')
  if [ -n "$jobs" ]; then
    print_section "Employment"
    echo "$person_data" | jq -r '.jobs[] | "\(.title // "")|\(.organization // "")|\(.display // "")"' | \
      while IFS="|" read -r title org display; do
        printf "  "
        [ -n "$title" ] && printf "${yellow}%s${reset}" "$title"
        [ -n "$title" ] && [ -n "$org" ] && printf " at "
        [ -n "$org" ] && printf "${blue}%s${reset}" "$org"
        [ -n "$display" ] && [ "$display" != "$title $org" ] && printf " ${dim}(%s)${reset}" "$display"
        printf "\n"
      done
  fi

  # Education
  local educations
  educations=$(echo "$person_data" | jq -r '.educations[]? // empty')
  if [ -n "$educations" ]; then
    print_section "Education"
    echo "$person_data" | jq -r '.educations[] | "\(.degree // "")|\(.school // "")|\(.display // "")"' | \
      while IFS="|" read -r degree school display; do
        printf "  "
        [ -n "$degree" ] && printf "${yellow}%s${reset}" "$degree"
        [ -n "$degree" ] && [ -n "$school" ] && printf " from "
        [ -n "$school" ] && printf "${blue}%s${reset}" "$school"
        [ -n "$display" ] && [ "$display" != "$degree $school" ] && printf " ${dim}(%s)${reset}" "$display"
        printf "\n"
      done
  fi

  # Usernames
  local usernames
  usernames=$(echo "$person_data" | jq -r '.usernames[]? // empty')
  if [ -n "$usernames" ]; then
    print_section "Usernames"
    echo "$person_data" | jq -r '.usernames[].content // empty' | \
      while read -r username; do
        printf "  ${cyan}@%s${reset}\n" "$username"
      done
  fi

  # User IDs
  local user_ids
  user_ids=$(echo "$person_data" | jq -r '.user_ids[]? // empty')
  if [ -n "$user_ids" ]; then
    print_section "Social Media IDs"
    echo "$person_data" | jq -r '.user_ids[].content // empty' | \
      while read -r user_id; do
        printf "  ${blue}%s${reset}\n" "$user_id"
      done
  fi

  # Images
  local images
  images=$(echo "$person_data" | jq -r '.images[]? // empty')
  if [ -n "$images" ]; then
    print_section "Profile Images"
    echo "$person_data" | jq -r '.images[].url // empty' | \
      while read -r url; do
        printf "  ${blue}%s${reset}\n" "$url"
      done
  fi

  # Relationships
  local relationships
  relationships=$(echo "$person_data" | jq -r '.relationships[]? // empty')
  if [ -n "$relationships" ]; then
    print_section "Relationships"
    echo "$person_data" | jq -r '.relationships[] | "\(.["@type"] // "")|\(.["@subtype"] // "")|\(.names[0].display // (.names[0].first + " " + .names[0].last) // "")"' | \
      while IFS="|" read -r type subtype name; do
        printf "  ${cyan}%s" "$type"
        [ -n "$subtype" ] && printf " (%s)" "$subtype"
        printf ":${reset} ${green}%s${reset}\n" "$name"
      done
  fi

  # Languages
  local languages
  languages=$(echo "$person_data" | jq -r '.languages[]? // empty')
  if [ -n "$languages" ]; then
    print_section "Languages"
    echo "$person_data" | jq -r '.languages[] | "\(.language // "")|\(.region // "")"' | \
      while IFS="|" read -r language region; do
        printf "  ${magenta}%s${reset}" "$language"
        [ -n "$region" ] && printf " ${dim}(%s)${reset}" "$region"
        printf "\n"
      done
  fi

  # Search pointer for follow-up searches
  if [ "$search_pointer" != "N/A" ] && [ "$match_type" = "possible" ]; then
    print_section "Follow-up Search"
    printf "  ${dim}Use: $(basename "$0") pointer --search-pointer '%s'${reset}\n" "${search_pointer:0:50}..."
  fi
}

show_rate_limits() {
  local response="$1"

  # Extract rate limit headers (these would typically come from curl headers, but we'd need to modify the request)
  # For now, we'll show package info if available in response
  printf "\n${dim}API Usage Information:${reset}\n"
  printf "${dim}For detailed rate limits and quotas, check response headers or your PIPL dashboard${reset}\n"
}

# Function to follow search_id for additional results
# Format response without following search pointers (to avoid recursion)
format_single_response() {
  local response="$1"
  local persons_count
  local search_id
  local available_sources
  local visible_sources
  
  persons_count=$(echo "$response" | jq -r '.["@persons_count"] // 0')
  search_id=$(echo "$response" | jq -r '.["@search_id"] // "N/A"')
  available_sources=$(echo "$response" | jq -r '.["@available_sources"] // 0')
  visible_sources=$(echo "$response" | jq -r '.["@visible_sources"] // 0')

  # Print search metadata
  printf "${dim}Search ID: %s | Sources: %s available, %s visible${reset}\n\n" \
    "$search_id" "$available_sources" "$visible_sources"

  # Process exact match person
  local person_data
  person_data=$(echo "$response" | jq -r '.person // empty')
  if [ -n "$person_data" ] && [ "$person_data" != "null" ]; then
    printf "${bold}${green}EXACT MATCH (from follow-up)${reset}\n"
    printf "${bold}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${reset}\n\n"
    format_single_person "$person_data" "exact"
  fi

  # Process possible persons
  local possible_persons
  possible_persons=$(echo "$response" | jq -r '.possible_persons[]? // empty')
  if [ -n "$possible_persons" ]; then
    printf "\n${bold}${yellow}POSSIBLE MATCHES (from follow-up)${reset}\n"
    printf "${bold}━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━${reset}\n\n"

    local count=1
    echo "$response" | jq -c '.possible_persons[]?' | while read -r person; do
      printf "${bold}Possible Match #%s${reset}\n" "$count"
      format_single_person "$person" "possible"
      printf "\n"
      count=$((count + 1))
    done
  fi
}

follow_search_pointer() {
  local search_pointer="$1"
  local follow_count="$2"
  
  if [ -z "$search_pointer" ] || [ "$search_pointer" = "N/A" ]; then
    return 0
  fi
  
  if [ "$follow_count" -gt 5 ]; then
    # Maximum follow depth reached
    return 0
  fi
  
  # Following search pointer silently
  
  # Build params for search pointer follow-up
  local config_params=""
  [ -n "$argc_minimum_probability" ] && config_params="${config_params}&minimum_probability=${argc_minimum_probability}"
  [ -n "$argc_minimum_match" ] && config_params="${config_params}&minimum_match=${argc_minimum_match}"
  [ -n "$argc_show_sources" ] && config_params="${config_params}&show_sources=${argc_show_sources}"
  if [ "$argc_live_feeds" = 1 ]; then
    config_params="${config_params}&live_feeds=true"
  fi
  [ -n "$argc_match_requirements" ] && config_params="${config_params}&match_requirements=${argc_match_requirements}"
  [ -n "$argc_source_category_requirements" ] && config_params="${config_params}&source_category_requirements=${argc_source_category_requirements}"
  # Default to top_match=true unless --no-top-match is specified
  if [ "$argc_no_top_match" != 1 ]; then
    config_params="${config_params}&top_match=true"
  fi
  [ "$argc_hide_sponsored" = 1 ] && config_params="${config_params}&hide_sponsored=true"
  
  # Use search pointer (sp) parameter for follow-up searches
  local data="sp=${search_pointer}"
  local follow_response
  
  follow_response=$(make_request "POST" "$config_params" "$data")
  
  if [ -n "$follow_response" ]; then
    echo "$follow_response" | jq
    
    # Check if there's another search pointer to follow recursively
    local next_search_pointer
    next_search_pointer=$(echo "$follow_response" | jq -r '.person["@search_pointer"] // .possible_persons[0]["@search_pointer"] // empty')
    if [ -n "$next_search_pointer" ] && [ "$next_search_pointer" != "N/A" ] && [ "$next_search_pointer" != "$search_pointer" ]; then
      follow_search_pointer "$next_search_pointer" $((follow_count + 1))
    fi
  fi
}

# Main command processing
if [ -z "$argc_command" ]; then
  show_help
  exit 0
fi

case "$argc_command" in
people)
  # Validate that at least one search parameter is provided
  if [ -z "$argc_first_name$argc_last_name$argc_raw_name$argc_username$argc_user_id$argc_url$argc_city$argc_state$argc_country$argc_raw_address$argc_age" ]; then
    echo "${red}Error:${reset} At least one search parameter is required." >&2
    echo "Use name, username, user_id, url, address, or age." >&2
    exit 1
  fi

  params=$(build_search_params)
  response=$(make_request "GET" "$params")
  echo "$response" | jq
  ;;

email)
  # For email command, use the positional argument as email
  if [ -z "$argc_value" ]; then
    echo "${red}Error:${reset} Email address is required as positional argument." >&2
    echo "Usage: $(basename "$0") email <email-address>" >&2
    exit 1
  fi
  # Set the email parameter and clear other search parameters to avoid conflicts
  argc_email="$argc_value"
  argc_first_name="" argc_last_name="" argc_phone="" argc_username="" argc_user_id="" argc_url="" argc_city="" argc_state="" argc_country="" argc_raw_address="" argc_age="" argc_raw_name="" argc_middle_name="" argc_house="" argc_street="" argc_zipcode=""

  params=$(build_search_params)
  response=$(make_request "GET" "$params")
  echo "$response" | jq
  ;;

phone)
  # For phone command, use the positional argument as phone
  if [ -z "$argc_value" ]; then
    echo "${red}Error:${reset} Phone number is required as positional argument." >&2
    echo "Usage: $(basename "$0") phone <phone-number>" >&2
    exit 1
  fi
  # Set the phone parameter and clear other search parameters to avoid conflicts
  argc_phone="$argc_value"
  argc_first_name="" argc_last_name="" argc_email="" argc_username="" argc_user_id="" argc_url="" argc_city="" argc_state="" argc_country="" argc_raw_address="" argc_age="" argc_raw_name="" argc_middle_name="" argc_house="" argc_street="" argc_zipcode=""

  params=$(build_search_params)
  response=$(make_request "GET" "$params")
  echo "$response" | jq
  ;;

pointer)
  # For pointer command, use positional argument or --search-pointer flag
  search_pointer="$argc_value"
  if [ -z "$search_pointer" ] && [ -n "$argc_search_pointer" ]; then
    search_pointer="$argc_search_pointer"
  fi
  
  if [ -z "$search_pointer" ]; then
    echo "${red}Error:${reset} Search pointer is required as positional argument or --search-pointer flag." >&2
    echo "Usage: $(basename "$0") pointer <search-pointer>" >&2
    exit 1
  fi

  config_params=""
  [ -n "$argc_minimum_probability" ] && config_params="${config_params}&minimum_probability=${argc_minimum_probability}"
  [ -n "$argc_minimum_match" ] && config_params="${config_params}&minimum_match=${argc_minimum_match}"
  [ -n "$argc_show_sources" ] && config_params="${config_params}&show_sources=${argc_show_sources}"
  if [ "$argc_live_feeds" = 1 ]; then
    config_params="${config_params}&live_feeds=true"
  fi
  [ -n "$argc_match_requirements" ] && config_params="${config_params}&match_requirements=${argc_match_requirements}"
  [ -n "$argc_source_category_requirements" ] && config_params="${config_params}&source_category_requirements=${argc_source_category_requirements}"
  # Default to top_match=true unless --no-top-match is specified
  if [ "$argc_no_top_match" != 1 ]; then
    config_params="${config_params}&top_match=true"
  fi
  [ "$argc_hide_sponsored" = 1 ] && config_params="${config_params}&hide_sponsored=true"

  data="sp=${search_pointer}"
  response=$(make_request "POST" "$config_params" "$data")
  echo "$response" | jq
  ;;

person-json)
  # For person-json command, use positional argument or --person-json flag
  person_json="$argc_value"
  if [ -z "$person_json" ] && [ -n "$argc_person_json" ]; then
    person_json="$argc_person_json"
  fi
  
  if [ -z "$person_json" ]; then
    echo "${red}Error:${reset} Person JSON string is required as positional argument or --person-json flag." >&2
    echo "Usage: $(basename "$0") person-json <json-string>" >&2
    echo "Example: $(basename "$0") person-json '{\"names\":[{\"first\":\"John\",\"last\":\"Doe\"}]}'" >&2
    exit 1
  fi

  # Validate JSON
  if ! echo "$person_json" | jq . >/dev/null 2>&1; then
    echo "${red}Error:${reset} Invalid JSON in person parameter." >&2
    exit 1
  fi

  config_params=""
  [ -n "$argc_minimum_probability" ] && config_params="${config_params}&minimum_probability=${argc_minimum_probability}"
  [ -n "$argc_minimum_match" ] && config_params="${config_params}&minimum_match=${argc_minimum_match}"
  [ -n "$argc_show_sources" ] && config_params="${config_params}&show_sources=${argc_show_sources}"
  if [ "$argc_live_feeds" = 1 ]; then
    config_params="${config_params}&live_feeds=true"
  fi
  [ -n "$argc_match_requirements" ] && config_params="${config_params}&match_requirements=${argc_match_requirements}"
  [ -n "$argc_source_category_requirements" ] && config_params="${config_params}&source_category_requirements=${argc_source_category_requirements}"
  # Default to top_match=true unless --no-top-match is specified
  if [ "$argc_no_top_match" != 1 ]; then
    config_params="${config_params}&top_match=true"
  fi
  [ "$argc_hide_sponsored" = 1 ] && config_params="${config_params}&hide_sponsored=true"

  # URL encode the JSON
  encoded_person=$(printf '%s' "$person_json" | sed 's/ /%20/g; s/"/%22/g; s/{/%7B/g; s/}/%7D/g; s/\[/%5B/g; s/\]/%5D/g; s/:/%3A/g; s/,/%2C/g')
  data="person=${encoded_person}"
  response=$(make_request "POST" "$config_params" "$data")
  echo "$response" | jq
  ;;

*)
  echo "${red}Error:${reset} Unknown command: ${argc_command}" >&2
  show_help
  exit 1
  ;;
esac

# Rate limit info removed - JSON output only
