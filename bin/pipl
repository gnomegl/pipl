_argc_usage_people() {
    cat <<-'EOF'
Search for people by name, location, email, or phone

USAGE: pipl people [OPTIONS] [QUERY]

ARGS:
  [QUERY]  "Quick search: 'John Doe' or 'john.doe@email.com' or phone"

OPTIONS:
  -f, --first <FIRST>      "First name"
  -l, --last <LAST>        "Last name"
  -m, --middle <MIDDLE>    "Middle name"
  -n, --name <NAME>        "Full name (unparsed)"
      --house <HOUSE>      "House number"
      --street <STREET>    "Street name"
  -c, --city <CITY>        "City name"
  -s, --state <STATE>      "State or province"
  -z, --zip <ZIP>          "ZIP/postal code"
      --country <COUNTRY>  "Country (2-letter ISO code)"
  -a, --address <ADDRESS>  "Full address (unparsed)"
      --age <AGE>          "Age or age range (e.g., 25 or 25-30)"
      --no-followup        "Disable automatic search pointer follow-up"
  -h, --help               Print help
EOF
    exit
}

_argc_parse_people() {
    local _argc_key _argc_action
    local _argc_subcmds=""
    while [[ $_argc_index -lt $_argc_len ]]; do
        _argc_item="${argc__args[_argc_index]}"
        _argc_key="${_argc_item%%=*}"
        case "$_argc_key" in
        --help | -help | -h)
            _argc_usage_people
            ;;
        --)
            _argc_dash="${#argc__positionals[@]}"
            argc__positionals+=("${argc__args[@]:$((_argc_index + 1))}")
            _argc_index=$_argc_len
            break
            ;;
        --first | -f)
            _argc_take_args "--first <FIRST>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_first:-}" ]]; then
                argc_first="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--first\` cannot be used multiple times"
            fi
            ;;
        --last | -l)
            _argc_take_args "--last <LAST>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_last:-}" ]]; then
                argc_last="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--last\` cannot be used multiple times"
            fi
            ;;
        --middle | -m)
            _argc_take_args "--middle <MIDDLE>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_middle:-}" ]]; then
                argc_middle="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--middle\` cannot be used multiple times"
            fi
            ;;
        --name | -n)
            _argc_take_args "--name <NAME>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_name:-}" ]]; then
                argc_name="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--name\` cannot be used multiple times"
            fi
            ;;
        --house)
            _argc_take_args "--house <HOUSE>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_house:-}" ]]; then
                argc_house="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--house\` cannot be used multiple times"
            fi
            ;;
        --street)
            _argc_take_args "--street <STREET>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_street:-}" ]]; then
                argc_street="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--street\` cannot be used multiple times"
            fi
            ;;
        --city | -c)
            _argc_take_args "--city <CITY>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_city:-}" ]]; then
                argc_city="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--city\` cannot be used multiple times"
            fi
            ;;
        --state | -s)
            _argc_take_args "--state <STATE>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_state:-}" ]]; then
                argc_state="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--state\` cannot be used multiple times"
            fi
            ;;
        --zip | -z)
            _argc_take_args "--zip <ZIP>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_zip:-}" ]]; then
                argc_zip="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--zip\` cannot be used multiple times"
            fi
            ;;
        --country)
            _argc_take_args "--country <COUNTRY>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_country:-}" ]]; then
                argc_country="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--country\` cannot be used multiple times"
            fi
            ;;
        --address | -a)
            _argc_take_args "--address <ADDRESS>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_address:-}" ]]; then
                argc_address="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--address\` cannot be used multiple times"
            fi
            ;;
        --age)
            _argc_take_args "--age <AGE>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_age:-}" ]]; then
                argc_age="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--age\` cannot be used multiple times"
            fi
            ;;
        --no-followup)
            if [[ "$_argc_item" == *=* ]]; then
                _argc_die "error: flag \`--no-followup\` don't accept any value"
            fi
            _argc_index=$((_argc_index + 1))
            if [[ -n "${argc_no_followup:-}" ]]; then
                _argc_die "error: the argument \`--no-followup\` cannot be used multiple times"
            else
                argc_no_followup=1
            fi
            ;;
        *)
            if _argc_maybe_flag_option "-" "$_argc_item"; then
                _argc_die "error: unexpected argument \`$_argc_key\` found"
            fi
            argc__positionals+=("$_argc_item")
            _argc_index=$((_argc_index + 1))
            ;;
        esac
    done
    _argc_tools=(curl jq)
    if [[ -n "${_argc_action:-}" ]]; then
        $_argc_action
    else
        argc__fn=people
        if [[ "${argc__positionals[0]:-}" == "help" ]] && [[ "${#argc__positionals[@]}" -eq 1 ]]; then
            _argc_usage_people
        fi
        _argc_match_positionals 0
        local values_index values_size
        IFS=: read -r values_index values_size <<<"${_argc_match_positionals_values[0]:-}"
        if [[ -n "$values_index" ]]; then
            argc_query="${argc__positionals[values_index]}"
        fi
    fi
}

