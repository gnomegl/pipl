#!/usr/bin/env bash

# @describe PIPL Search API client for people intelligence and data enrichment
# @meta require-tools curl,jq

# Global options
# @option -k --key "PIPL API key (can also use PIPL_API_KEY env var)"
# @flag -j --json "Output raw JSON (default is formatted)"
# @flag -q --quiet "Suppress colored output"

# Search configuration options (inherited by search commands)
# @option --minimum-probability "Minimum acceptable probability for inferred data (0-1)" @default "0.9"
# @option --minimum-match "Minimum required match score for possible persons (0-1)" @default "0"
# @option --show-sources "Sources to show" [true|false|all|matching] @default "true"
# @flag --no-live-feeds "Disable live data sources"
# @option --match-requirements "Fields that must be present in response"
# @option --source-category-requirements "Source categories that must be present"
# @flag --top-match "Return only the top match (default behavior)"
# @flag --hide-sponsored "Omit sponsored results"

setup_colors() {
  if [[ "${argc_quiet:-0}" == "1" || -z "$TERM" || "$TERM" == "dumb" ]]; then
    bold="" reset="" blue="" green="" yellow="" cyan="" magenta="" red="" dim=""
  else
    bold=$(tput bold) reset=$(tput sgr0) blue=$(tput setaf 4) green=$(tput setaf 2)
    yellow=$(tput setaf 3) cyan=$(tput setaf 6) magenta=$(tput setaf 5) red=$(tput setaf 1)
    dim=$(tput dim)
  fi
}

get_api_key() {
  if [[ -n "$argc_key" ]]; then
    echo "$argc_key"
  elif [[ -n "$PIPL_API_KEY" ]]; then
    echo "$PIPL_API_KEY"
  elif [[ -f "$HOME/.config/pipl/api_key" ]]; then
    cat "$HOME/.config/pipl/api_key"
  else
    printf "%sError:%s No PIPL API key found.\n" "$red" "$reset" >&2
    echo "Set with --key, PIPL_API_KEY env var, or ~/.config/pipl/api_key file" >&2
    exit 1
  fi
}

make_request() {
  local method="$1"
  local params="$2"
  local data="$3"

  local url="https://api.pipl.com/search?key=${API_KEY}${params}"
  local response

  if [[ "$method" == "GET" ]]; then
    response=$(curl -s "$url")
  else
    response=$(curl -s -X POST -H "Content-Type: application/x-www-form-urlencoded" -d "$data" "$url")
  fi

  local http_status
  http_status=$(echo "$response" | jq -r '.["@http_status_code"] // 200')
  if [[ "$http_status" != "200" ]]; then
    local error_msg
    error_msg=$(echo "$response" | jq -r '.error // "Unknown error"')
    printf "%sError (HTTP %s):%s %s\n" "$red" "$http_status" "$error_msg" "$reset" >&2

    local warnings
    warnings=$(echo "$response" | jq -r '.warnings[]?' 2>/dev/null)
    if [[ -n "$warnings" ]]; then
      printf "%sWarnings:%s\n" "$yellow" "$reset" >&2
      while read -r warning; do
        printf "  %s•%s %s\n" "$yellow" "$reset" "$warning" >&2
      done <<<"$warnings"
    fi
    exit 1
  fi

  echo "$response"
}

build_search_params() {
  local params=""

  [[ -n "$argc_minimum_probability" ]] && params+="&minimum_probability=${argc_minimum_probability}"
  [[ -n "$argc_minimum_match" ]] && params+="&minimum_match=${argc_minimum_match}"
  [[ -n "$argc_show_sources" ]] && params+="&show_sources=${argc_show_sources}"
  [[ "${argc_no_live_feeds:-0}" == "1" ]] && params+="&live_feeds=false"
  [[ -n "$argc_match_requirements" ]] && params+="&match_requirements=${argc_match_requirements}"
  [[ -n "$argc_source_category_requirements" ]] && params+="&source_category_requirements=${argc_source_category_requirements}"
  [[ "${argc_top_match:-0}" == "1" ]] && params+="&top_match=true"
  [[ "${argc_hide_sponsored:-0}" == "1" ]] && params+="&hide_sponsored=true"

  echo "$params"
}

url_encode() {
  local string="$1"
  printf '%s' "$string" | sed 's/ /%20/g; s/@/%40/g; s/\./%2E/g; s/+/%2B/g; s/&/%26/g'
}

format_person() {
  local person="$1"
  local match_score=""

  match_score=$(echo "$person" | jq -r '.["@match"] // empty')
  [[ -n "$match_score" ]] && printf "${bold}Match Score:${reset} ${yellow}%.2f${reset}\n" "$match_score"

  local names
  names=$(echo "$person" | jq -r '.names[]?' 2>/dev/null)
  if [[ -n "$names" ]]; then
    printf "\n%sNames:%s\n" "$bold" "$reset"
    echo "$person" | jq -r '.names[] | "\(.first // "")|\(.middle // "")|\(.last // "")|\(.display // "")"' |
      while IFS="|" read -r first middle last display; do
        printf "  %s%%s" "$green" "$first"
        [[ -n "$middle" ]] && printf " %s" "$middle"
        [[ -n "$last" ]] && printf " %s" "$last"
        [[ -n "$display" && "$display" != "$first $middle $last" ]] && printf " ${dim}(%s)${reset}" "$display"
        printf "%s\n" "$reset"
      done
  fi

  local gender
  gender=$(echo "$person" | jq -r '.gender.content // empty')
  local dob
  dob=$(echo "$person" | jq -r '.dob.display // empty')

  if [[ -n "$gender" || -n "$dob" ]]; then
    printf "\n%sPersonal Info:%s\n" "$bold" "$reset"
    [[ -n "$gender" ]] && printf "  %sGender:%s %s%s%s\n" "$cyan" "$reset" "$magenta" "$gender" "$reset"
    [[ -n "$dob" ]] && printf "  %sDate of Birth:%s %s%s%s\n" "$cyan" "$reset" "$yellow" "$dob" "$reset"
  fi

  local phones
  phones=$(echo "$person" | jq -r '.phones[]?' 2>/dev/null)
  if [[ -n "$phones" ]]; then
    printf "\n%sPhone Numbers:%s\n" "$bold" "$reset"
    echo "$person" | jq -r '.phones[] | "\(.["@type"] // "phone")|\(.display_international // .display // "")"' |
      while IFS="|" read -r type display; do
        printf "  %s%s:%s %s%s%s\n" "$cyan" "${type^}" "$reset" "$blue" "$display" "$reset"
      done
  fi

  local addresses
  addresses=$(echo "$person" | jq -r '.addresses[]?' 2>/dev/null)
  if [[ -n "$addresses" ]]; then
    printf "\n%sAddresses:%s\n" "$bold" "$reset"
    echo "$person" | jq -r '.addresses[].display // empty' |
      while read -r address; do
        [[ -n "$address" ]] && printf "  %s%s%s\n" "$magenta" "$address" "$reset"
      done
  fi

  local jobs
  jobs=$(echo "$person" | jq -r '.jobs[]?' 2>/dev/null)
  if [[ -n "$jobs" ]]; then
    printf "\n%sEmployment:%s\n" "$bold" "$reset"
    echo "$person" | jq -r '.jobs[] | "\(.title // "")|\(.organization // "")"' |
      while IFS="|" read -r title org; do
        printf "  %s%s%s" "$yellow" "$title" "$reset"
        [[ -n "$org" ]] && printf " at %s%s%s" "$blue" "$org" "$reset"
        printf "\n"
      done
  fi

  local educations
  educations=$(echo "$person" | jq -r '.educations[]?' 2>/dev/null)
  if [[ -n "$educations" ]]; then
    printf "\n%sEducation:%s\n" "$bold" "$reset"
    echo "$person" | jq -r '.educations[] | "\(.degree // "")|\(.school // "")"' |
      while IFS="|" read -r degree school; do
        printf "  %s%s%s" "$yellow" "$degree" "$reset"
        [[ -n "$school" ]] && printf " from %s%s%s" "$blue" "$school" "$reset"
        printf "\n"
      done
  fi

  local usernames
  usernames=$(echo "$person" | jq -r '.usernames[]?' 2>/dev/null)
  local user_ids
  user_ids=$(echo "$person" | jq -r '.user_ids[]?' 2>/dev/null)

  if [[ -n "$usernames" || -n "$user_ids" ]]; then
    printf "\n%sSocial Media:%s\n" "$bold" "$reset"
    echo "$person" | jq -r '.usernames[].content // empty' |
      while read -r username; do
        printf "  %s@%s%s\n" "$cyan" "$username" "$reset"
      done
    echo "$person" | jq -r '.user_ids[].content // empty' |
      while read -r user_id; do
        printf "  %s%s%s\n" "$blue" "$user_id" "$reset"
      done
  fi

  local search_pointer
  search_pointer=$(echo "$person" | jq -r '.["@search_pointer"] // empty')
  if [[ -n "$search_pointer" ]]; then
    printf "\n%sFollow-up search: pipl pointer '%s'%s\n" "$dim" "${search_pointer:0:50}..." "$reset"
  fi
}

format_response() {
  local response="$1"

  if [[ "${argc_json:-0}" == "1" ]]; then
    echo "$response" | jq
    return
  fi

  local persons_count
  persons_count=$(echo "$response" | jq -r '.["@persons_count"] // 0')
  local search_id
  search_id=$(echo "$response" | jq -r '.["@search_id"] // "N/A"')

  printf "%sSearch ID: %s | Persons found: %s%s\n" "$dim" "$search_id" "$persons_count" "$reset"

  local person
  person=$(echo "$response" | jq -r '.person // empty')
  if [[ -n "$person" && "$person" != "null" ]]; then
    printf "\n%s%sEXACT MATCH%s\n" "$bold" "$green" "$reset"
    printf "${bold}%s${reset}\n" "$(printf '━%.0s' {1..60})"
    format_person "$person"
  fi

  local possible_count
  possible_count=$(echo "$response" | jq -r '.possible_persons | length // 0')
  if [[ "$possible_count" -gt 0 ]]; then
    printf "\n%s%sPOSSIBLE MATCHES (%s)%s\n" "$bold" "$yellow" "$possible_count" "$reset"
    printf "%s%s%s\n" "$bold" "$(printf '━%.0s' {1..60})" "$reset"

    local count=1
    echo "$response" | jq -c '.possible_persons[]?' | while read -r possible_person; do
      printf "\n%sMatch #%s:%s\n" "$bold" "$count" "$reset"
      format_person "$possible_person"
      count=$((count + 1))
    done
  fi

  local warnings
  warnings=$(echo "$response" | jq -r '.warnings[]?' 2>/dev/null)
  if [[ -n "$warnings" ]]; then
    printf "\n%sWarnings:%s\n" "$yellow" "$reset"
    while read -r warning; do
      printf "  %s•%s %s\n" "$yellow" "$reset" "$warning"
    done <<<"$warnings"
  fi
}

# @cmd Search by email address
# @arg email! "Email address to search"
email() {
  setup_colors
  API_KEY=$(get_api_key)

  local params
  params=$(build_search_params)
  # shellcheck disable=SC2154
  params+="&email=$(url_encode "${argc_email}")"

  local response
  response=$(make_request "GET" "$params")
  format_response "$response"
}

# @cmd Search by phone number
# @arg phone! "Phone number (international format preferred)"
phone() {
  setup_colors
  API_KEY=$(get_api_key)

  local cleaned_phone
  # shellcheck disable=SC2154
  cleaned_phone=$(echo "${argc_phone}" | tr -d '().-' | tr -s ' ')

  local params
  params=$(build_search_params)
  params+="&phone=$(url_encode "$cleaned_phone")"

  local response
  response=$(make_request "GET" "$params")
  format_response "$response"
}

# @cmd Search by username
# @arg username! "Username (minimum 3 characters)"
username() {
  setup_colors
  API_KEY=$(get_api_key)

  # shellcheck disable=SC2154
  if [[ ${#argc_username} -lt 3 ]]; then
    echo "${red}Error:${reset} Username must be at least 3 characters" >&2
    exit 1
  fi

  local params
  params=$(build_search_params)
  params+="&username=${argc_username}"

  local response
  response=$(make_request "GET" "$params")
  format_response "$response"
}

# @cmd Search by social media URL
# @arg url! "Social media profile URL"
url() {
  setup_colors
  API_KEY=$(get_api_key)

  local params
  params=$(build_search_params)
  # shellcheck disable=SC2154
  params+="&url=$(url_encode "${argc_url}")"

  local response
  response=$(make_request "GET" "$params")
  format_response "$response"
}

# @cmd Search by user ID
# @arg user_id! "User ID with service (e.g., 123456@facebook)"
user-id() {
  setup_colors
  API_KEY=$(get_api_key)

  local params
  params=$(build_search_params)
  # shellcheck disable=SC2154
  params+="&user_id=$(url_encode "${argc_user_id}")"

  local response
  response=$(make_request "GET" "$params")
  format_response "$response"
}

# @cmd Follow up on a search pointer
# @arg search_pointer! "Search pointer from previous results"
pointer() {
  setup_colors
  API_KEY=$(get_api_key)

  local params
  params=$(build_search_params)
  # shellcheck disable=SC2154
  local data="sp=${argc_search_pointer}"

  local response
  response=$(make_request "POST" "$params" "$data")
  format_response "$response"
}

# @cmd Search for people by name, location, email, or phone
# @alias search
# @option -f --first "First name"
# @option -l --last "Last name"
# @option -m --middle "Middle name"
# @option -n --name "Full name (unparsed)"
# @option --house "House number"
# @option --street "Street name"
# @option -c --city "City name"
# @option -s --state "State or province"
# @option -z --zip "ZIP/postal code"
# @option --country "Country (2-letter ISO code)"
# @option -a --address "Full address (unparsed)"
# @option --age "Age or age range (e.g., 25 or 25-30)"
# @flag --no-followup "Disable automatic search pointer follow-up"
# @arg query "Quick search: 'John Doe' or 'john.doe@email.com' or phone"
people() {
  setup_colors
  API_KEY=$(get_api_key)

  local params
  params=$(build_search_params)

  # If a quick query arg is provided, determine what it is
  # shellcheck disable=SC2154
  if [[ -n "${argc_query}" ]]; then
    # Check if it's an email
    if [[ "${argc_query}" =~ ^[^@]+@[^@]+\.[^@]+$ ]]; then
      params+="&email=$(url_encode "${argc_query}")"
    # Check if it's a phone number (contains mostly digits)
    elif [[ "${argc_query}" =~ ^[0-9+\(\)\ \-\.]+$ ]] && [[ "${#argc_query}" -ge 7 ]]; then
      local cleaned_phone
      cleaned_phone=$(echo "${argc_query}" | tr -d '().-' | tr -s ' ')
      params+="&phone=$(url_encode "$cleaned_phone")"
    # Otherwise treat as a name
    else
      params+="&raw_name=$(url_encode "${argc_query}")"
    fi
  fi

  # Add explicit parameters if provided
  [[ -n "${argc_first}" ]] && params+="&first_name=$(url_encode "${argc_first}")"
  [[ -n "${argc_middle}" ]] && params+="&middle_name=$(url_encode "${argc_middle}")"
  [[ -n "${argc_last}" ]] && params+="&last_name=$(url_encode "${argc_last}")"
  [[ -n "${argc_name}" ]] && params+="&raw_name=$(url_encode "${argc_name}")"
  [[ -n "${argc_house}" ]] && params+="&house=$(url_encode "${argc_house}")"
  [[ -n "${argc_street}" ]] && params+="&street=$(url_encode "${argc_street}")"
  [[ -n "${argc_city}" ]] && params+="&city=$(url_encode "${argc_city}")"
  [[ -n "${argc_state}" ]] && params+="&state=$(url_encode "${argc_state}")"
  [[ -n "${argc_zip}" ]] && params+="&zipcode=${argc_zip}"
  [[ -n "${argc_country}" ]] && params+="&country=${argc_country}"
  [[ -n "${argc_address}" ]] && params+="&raw_address=$(url_encode "${argc_address}")"
  [[ -n "${argc_age}" ]] && params+="&age=${argc_age}"

  # Check if we have at least one search parameter
  if [[ -z "${argc_query}${argc_first}${argc_last}${argc_name}${argc_city}${argc_state}${argc_country}${argc_address}${argc_age}${argc_house}${argc_street}" ]]; then
    echo "${red}Error:${reset} At least one search parameter is required" >&2
    echo "Try: pipl people 'John Doe' or pipl people --first John --last Doe" >&2
    exit 1
  fi

  local response
  response=$(make_request "GET" "$params")
  
  # Check if we got an exact match with a search pointer and auto-followup is enabled
  if [[ "${argc_no_followup:-0}" != "1" ]]; then
    local person_pointer
    person_pointer=$(echo "$response" | jq -r '.person["@search_pointer"] // empty')
    
    if [[ -n "$person_pointer" ]]; then
      # Display initial results
      format_response "$response"
      
      # Inform user about follow-up
      printf "\n%s━━━ Fetching additional details via search pointer ━━━%s\n\n" "$cyan" "$reset"
      
      # Make follow-up request with search pointer
      local followup_params
      followup_params=$(build_search_params)
      local followup_data="sp=${person_pointer}"
      local followup_response
      followup_response=$(make_request "POST" "$followup_params" "$followup_data")
      
      # Display enhanced results
      printf "%s%sENHANCED MATCH DETAILS%s\n" "$bold" "$green" "$reset"
    printf "%s%s%s\n" "$bold" "$(printf '━%.0s' {1..60})" "$reset"
      format_response "$followup_response"
    else
      # No exact match or no search pointer, just display regular results
      format_response "$response"
    fi
  else
    # Auto-followup disabled, just display regular results
    format_response "$response"
  fi
}

# @cmd Search using person JSON object
# @arg person_json! "JSON person object"
person() {
  setup_colors
  API_KEY=$(get_api_key)
  # shellcheck disable=SC2154
  if ! echo "${argc_person_json}" | jq . >/dev/null 2>&1; then
    echo "${red}Error:${reset} Invalid JSON format" >&2
    exit 1
  fi

  local params
  params=$(build_search_params)
  local encoded_person
  encoded_person=$(url_encode "${argc_person_json}")
  local data="person=$encoded_person"

  local response
  response=$(make_request "POST" "$params" "$data")
  format_response "$response"
}

# ARGC-BUILD {
# This block was generated by argc (https://github.com/sigoden/argc).
# Modifying it manually is not recommended

_argc_run() {
    if [[ "${1:-}" == "___internal___" ]]; then
        _argc_die "error: unsupported ___internal___ command"
    fi
    if [[ "${OS:-}" == "Windows_NT" ]] && [[ -n "${MSYSTEM:-}" ]]; then
        set -o igncr
    fi
    argc__args=("$(basename "$0" .sh)" "$@")
    argc__positionals=()
    _argc_index=1
    _argc_len="${#argc__args[@]}"
    _argc_tools=()
    _argc_parse
    _argc_require_tools "${_argc_tools[@]}"
    if [ -n "${argc__fn:-}" ]; then
        $argc__fn "${argc__positionals[@]}"
    fi
}

_argc_usage() {
    cat <<-'EOF'
PIPL Search API client for people intelligence and data enrichment

USAGE: pipl [OPTIONS] <COMMAND>

OPTIONS:
  -k, --key <KEY>                                                    "PIPL API key (can also use PIPL_API_KEY env var)"
  -j, --json                                                         "Output raw JSON (default is formatted)"
  -q, --quiet                                                        "Suppress colored output"
      --minimum-probability <MINIMUM-PROBABILITY>                    "Minimum acceptable probability for inferred data (0-1)" @default "0.9"
      --minimum-match <MINIMUM-MATCH>                                "Minimum required match score for possible persons (0-1)" @default "0"
      --show-sources <SHOW-SOURCES>                                  "Sources to show" [true|false|all|matching] @default "true"
      --no-live-feeds                                                "Disable live data sources"
      --match-requirements <MATCH-REQUIREMENTS>                      "Fields that must be present in response"
      --source-category-requirements <SOURCE-CATEGORY-REQUIREMENTS>  "Source categories that must be present"
      --top-match                                                    "Return only the top match (default behavior)"
      --hide-sponsored                                               "Omit sponsored results"
  -h, --help                                                         Print help
  -V, --version                                                      Print version

COMMANDS:
  email     Search by email address
  phone     Search by phone number
  username  Search by username
  url       Search by social media URL
  user-id   Search by user ID
  pointer   Follow up on a search pointer
  people    Search for people by name, location, email, or phone [aliases: search]
  person    Search using person JSON object
EOF
    exit
}

_argc_version() {
    echo pipl 0.0.0
    exit
}

_argc_parse() {
    local _argc_key _argc_action
    local _argc_subcmds="email, phone, username, url, user-id, pointer, people, search, person"
    while [[ $_argc_index -lt $_argc_len ]]; do
        _argc_item="${argc__args[_argc_index]}"
        _argc_key="${_argc_item%%=*}"
        case "$_argc_key" in
        --help | -help | -h)
            _argc_usage
            ;;
        --version | -version | -V)
            _argc_version
            ;;
        --)
            _argc_dash="${#argc__positionals[@]}"
            argc__positionals+=("${argc__args[@]:$((_argc_index + 1))}")
            _argc_index=$_argc_len
            break
            ;;
        --key | -k)
            _argc_take_args "--key <KEY>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_key:-}" ]]; then
                argc_key="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--key\` cannot be used multiple times"
            fi
            ;;
        --json | -j)
            if [[ "$_argc_item" == *=* ]]; then
                _argc_die "error: flag \`--json\` don't accept any value"
            fi
            _argc_index=$((_argc_index + 1))
            if [[ -n "${argc_json:-}" ]]; then
                _argc_die "error: the argument \`--json\` cannot be used multiple times"
            else
                argc_json=1
            fi
            ;;
        --quiet | -q)
            if [[ "$_argc_item" == *=* ]]; then
                _argc_die "error: flag \`--quiet\` don't accept any value"
            fi
            _argc_index=$((_argc_index + 1))
            if [[ -n "${argc_quiet:-}" ]]; then
                _argc_die "error: the argument \`--quiet\` cannot be used multiple times"
            else
                argc_quiet=1
            fi
            ;;
        --minimum-probability)
            _argc_take_args "--minimum-probability <MINIMUM-PROBABILITY>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_minimum_probability:-}" ]]; then
                argc_minimum_probability="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--minimum-probability\` cannot be used multiple times"
            fi
            ;;
        --minimum-match)
            _argc_take_args "--minimum-match <MINIMUM-MATCH>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_minimum_match:-}" ]]; then
                argc_minimum_match="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--minimum-match\` cannot be used multiple times"
            fi
            ;;
        --show-sources)
            _argc_take_args "--show-sources <SHOW-SOURCES>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_show_sources:-}" ]]; then
                argc_show_sources="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--show-sources\` cannot be used multiple times"
            fi
            ;;
        --no-live-feeds)
            if [[ "$_argc_item" == *=* ]]; then
                _argc_die "error: flag \`--no-live-feeds\` don't accept any value"
            fi
            _argc_index=$((_argc_index + 1))
            if [[ -n "${argc_no_live_feeds:-}" ]]; then
                _argc_die "error: the argument \`--no-live-feeds\` cannot be used multiple times"
            else
                argc_no_live_feeds=1
            fi
            ;;
        --match-requirements)
            _argc_take_args "--match-requirements <MATCH-REQUIREMENTS>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_match_requirements:-}" ]]; then
                argc_match_requirements="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--match-requirements\` cannot be used multiple times"
            fi
            ;;
        --source-category-requirements)
            _argc_take_args "--source-category-requirements <SOURCE-CATEGORY-REQUIREMENTS>" 1 1 "-" ""
            _argc_index=$((_argc_index + _argc_take_args_len + 1))
            if [[ -z "${argc_source_category_requirements:-}" ]]; then
                argc_source_category_requirements="${_argc_take_args_values[0]:-}"
            else
                _argc_die "error: the argument \`--source-category-requirements\` cannot be used multiple times"
            fi
            ;;
        --top-match)
            if [[ "$_argc_item" == *=* ]]; then
                _argc_die "error: flag \`--top-match\` don't accept any value"
            fi
            _argc_index=$((_argc_index + 1))
            if [[ -n "${argc_top_match:-}" ]]; then
                _argc_die "error: the argument \`--top-match\` cannot be used multiple times"
            else
                argc_top_match=1
            fi
            ;;
        --hide-sponsored)
            if [[ "$_argc_item" == *=* ]]; then
                _argc_die "error: flag \`--hide-sponsored\` don't accept any value"
            fi
            _argc_index=$((_argc_index + 1))
            if [[ -n "${argc_hide_sponsored:-}" ]]; then
                _argc_die "error: the argument \`--hide-sponsored\` cannot be used multiple times"
            else
                argc_hide_sponsored=1
            fi
            ;;
        email)
            _argc_index=$((_argc_index + 1))
            _argc_action=_argc_parse_email
            break
            ;;
        phone)
            _argc_index=$((_argc_index + 1))
            _argc_action=_argc_parse_phone
            break
            ;;
        username)
            _argc_index=$((_argc_index + 1))
            _argc_action=_argc_parse_username
            break
            ;;
        url)
            _argc_index=$((_argc_index + 1))
            _argc_action=_argc_parse_url
            break
            ;;
        user-id)
            _argc_index=$((_argc_index + 1))
            _argc_action=_argc_parse_user-id
            break
            ;;
        pointer)
            _argc_index=$((_argc_index + 1))
            _argc_action=_argc_parse_pointer
            break
            ;;
        people | search)
            _argc_index=$((_argc_index + 1))
            _argc_action=_argc_parse_people
            break
            ;;
        person)
            _argc_index=$((_argc_index + 1))
            _argc_action=_argc_parse_person
            break
            ;;
        help)
            local help_arg="${argc__args[$((_argc_index + 1))]:-}"
            case "$help_arg" in
            email)
                _argc_usage_email
                ;;
            phone)
                _argc_usage_phone
                ;;
            username)
                _argc_usage_username
                ;;
            url)
                _argc_usage_url
                ;;
            user-id)
                _argc_usage_user-id
                ;;
            pointer)
                _argc_usage_pointer
                ;;
            people | search)
                _argc_usage_people
                ;;
            person)
                _argc_usage_person
                ;;
            "")
                _argc_usage
                ;;
            *)
                _argc_die "error: invalid value \`$help_arg\` for \`<command>\`"$'\n'"  [possible values: $_argc_subcmds]"
                ;;
            esac
            ;;
        *)
            if _argc_maybe_flag_option "-" "$_argc_item"; then
                _argc_die "error: unexpected argument \`$_argc_key\` found"
            fi
            _argc_die "error: \`pipl\` requires a subcommand but one was not provided"$'\n'"  [subcommands: $_argc_subcmds]"
            ;;
        esac
    done
    _argc_tools=(curl jq)
    if [[ -n "${_argc_action:-}" ]]; then
        $_argc_action
    else
        _argc_usage
    fi
}

_argc_usage_email() {
    cat <<-'EOF'
Search by email address

USAGE: pipl email <EMAIL>

ARGS:
  <EMAIL>  "Email address to search"
EOF
    exit
}

_argc_parse_email() {
    local _argc_key _argc_action
    local _argc_subcmds=""
    while [[ $_argc_index -lt $_argc_len ]]; do
        _argc_item="${argc__args[_argc_index]}"
        _argc_key="${_argc_item%%=*}"
        case "$_argc_key" in
        --help | -help | -h)
            _argc_usage_email
            ;;
        --)
            _argc_dash="${#argc__positionals[@]}"
            argc__positionals+=("${argc__args[@]:$((_argc_index + 1))}")
            _argc_index=$_argc_len
            break
            ;;
        *)
            argc__positionals+=("$_argc_item")
            _argc_index=$((_argc_index + 1))
            ;;
        esac
    done
    _argc_tools=(curl jq)
    if [[ -n "${_argc_action:-}" ]]; then
        $_argc_action
    else
        argc__fn=email
        if [[ "${argc__positionals[0]:-}" == "help" ]] && [[ "${#argc__positionals[@]}" -eq 1 ]]; then
            _argc_usage_email
        fi
        _argc_match_positionals 0
        local values_index values_size
        IFS=: read -r values_index values_size <<<"${_argc_match_positionals_values[0]:-}"
        if [[ -n "$values_index" ]]; then
            argc_email="${argc__positionals[values_index]}"
        else
            _argc_die "error: the required environments \`<EMAIL>\` were not provided"
        fi
    fi
}

